@page
@model ChangePasswordModel

@{
    ViewData["Title"] = "Parolni almashtirish";
}

<h1>Parolni almashtirish</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<form method="post" style="max-width: 480px;">
    <div class="form-group mb-3">
        <label asp-for="Input.OldPassword" class="form-label"></label>
        <div class="iz-password-wrap">
            <input asp-for="Input.OldPassword" class="form-control" id="oldPassword" autocomplete="current-password" />
            <button type="button" class="iz-password-toggle" data-target="oldPassword" aria-label="Parolni ko'rsatish">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Input.NewPassword" class="form-label"></label>
        <div class="iz-password-wrap">
            <input asp-for="Input.NewPassword" class="form-control" id="newPassword" autocomplete="new-password" />
            <button type="button" class="iz-password-toggle" data-target="newPassword" aria-label="Parolni ko'rsatish">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <div class="iz-password-wrap">
            <input asp-for="Input.ConfirmPassword" class="form-control" id="confirmPassword" autocomplete="new-password" />
            <button type="button" class="iz-password-toggle" data-target="confirmPassword" aria-label="Parolni ko'rsatish">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="bi bi-shield-lock"></i> Parolni yangilash
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.iz-password-toggle').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var input = document.getElementById(this.getAttribute('data-target'));
                var icon = this.querySelector('i');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            });
        });
    </script>
}