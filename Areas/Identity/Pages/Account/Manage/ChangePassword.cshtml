@page
@model ChangePasswordModel

@{
    ViewData["Title"] = "Parolni almashtirish";
}

<h1>Parolni almashtirish</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<form method="post" style="max-width: 480px;">
    <div class="form-group mb-3">
        <label asp-for="Input.OldPassword" class="form-label"></label>
        <div class="iz-password-wrap">
            <input asp-for="Input.OldPassword" class="form-control" id="oldPassword" autocomplete="current-password" />
            <button type="button" class="iz-password-toggle" data-target="oldPassword" aria-label="Parolni ko'rsatish">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Input.NewPassword" class="form-label"></label>
        <div class="iz-password-wrap">
            <input asp-for="Input.NewPassword" class="form-control" id="newPassword" autocomplete="new-password" />
            <button type="button" class="iz-password-toggle" data-target="newPassword" aria-label="Parolni ko'rsatish">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
        <ul class="list-unstyled small mt-2 mb-0" id="passwordRules" aria-live="polite">
            <li data-rule="length" class="text-muted"><i class="bi bi-x-circle me-1"></i>Kamida 8 belgi</li>
            <li data-rule="digit" class="text-muted"><i class="bi bi-x-circle me-1"></i>Kamida bitta raqam</li>
            <li data-rule="lowercase" class="text-muted"><i class="bi bi-x-circle me-1"></i>Kamida bitta kichik harf</li>
        </ul>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <div class="iz-password-wrap">
            <input asp-for="Input.ConfirmPassword" class="form-control" id="confirmPassword" autocomplete="new-password" />
            <button type="button" class="iz-password-toggle" data-target="confirmPassword" aria-label="Parolni ko'rsatish">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="bi bi-shield-lock"></i> Parolni yangilash
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Jonli parol qoidalari ro'yxati (yashil = bajarilgan)
        var rules = {
            length: function (v) { return v.length >= 8; },
            digit: function (v) { return /[0-9]/.test(v); },
            lowercase: function (v) { return /[a-z]/.test(v); }
        };
        var newPassword = document.getElementById('newPassword');
        var ruleItems = document.querySelectorAll('#passwordRules li');
        function refreshRules() {
            var value = newPassword ? newPassword.value : '';
            ruleItems.forEach(function (li) {
                var ok = rules[li.getAttribute('data-rule')](value);
                li.classList.toggle('text-success', ok);
                li.classList.toggle('text-muted', !ok);
                var icon = li.querySelector('i');
                icon.className = ok ? 'bi bi-check-circle-fill me-1' : 'bi bi-x-circle me-1';
            });
        }
        if (newPassword) {
            newPassword.addEventListener('input', refreshRules);
            refreshRules();
        }

        document.querySelectorAll('.iz-password-toggle').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var input = document.getElementById(this.getAttribute('data-target'));
                var icon = this.querySelector('i');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            });
        });
    </script>
}