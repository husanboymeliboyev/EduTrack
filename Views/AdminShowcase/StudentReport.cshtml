@model EduTrack.ViewModels.StudentShowcaseViewModel
@{
    Layout = null;
    ViewData["Title"] = Model.StudentName + " - Diagnostik Hisobot";
    var initials = string.Join("", Model.StudentName.Split(' ').Select(s => s[0]));
}

<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
            :root {
                --sodiq-bg: #F8F9FA;
                --sodiq-white: #FFFFFF;
                --sodiq-ink: #1C2321;
                --sodiq-muted: #6C757D;
                --sodiq-primary: #0E7C66;
                --sodiq-danger-bg: #FDECEA;
                --sodiq-danger-text: #C0392B;
                --sodiq-zaif: #C0392B;
                --sodiq-ortacha: #D68B2E;
                --sodiq-yaxshi: #346077;
                --sodiq-yuqori: #0E7C66;
                --sodiq-scale-sayoz: #CA4536;
                --sodiq-scale-zaif: #DC6E25;
                --sodiq-scale-ortacha: #C27C12;
                --sodiq-scale-yaxshi: #2B5AC1;
                --sodiq-scale-yuqori: #27925F;
                --sodiq-radius: 20px;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--sodiq-bg);
                color: var(--sodiq-ink);
                padding: 40px 0;
            }

            .report-card {
                background: var(--sodiq-white);
                border-radius: var(--sodiq-radius);
                padding: 30px;
                box-shadow: 0 4px 20px rgba(0,0,0,0.05);
                margin-bottom: 24px;
                border: none;
            }

            .back-link {
                color: var(--sodiq-muted);
                text-decoration: none;
                font-size: 0.9rem;
                display: flex;
                align-items: center;
                gap: 5px;
                margin-bottom: 20px;
            }

            .profile-header {
                display: flex;
                align-items: center;
                gap: 20px;
                margin-bottom: 30px;
            }

            .avatar {
                width: 80px;
                height: 80px;
                background: #E6F4F1;
                color: var(--sodiq-primary);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.8rem;
                font-weight: 700;
                font-family: 'Manrope', sans-serif;
            }

            .profile-info h1 {
                font-family: 'Manrope', sans-serif;
                font-weight: 800;
                font-size: 2.2rem;
                margin: 0;
            }

            .profile-info p {
                color: var(--sodiq-muted);
                margin: 0;
                font-size: 1.1rem;
            }

            .warning-box {
                background-color: var(--sodiq-danger-bg);
                color: var(--sodiq-danger-text);
                border-radius: var(--sodiq-radius);
                padding: 24px;
                margin-bottom: 24px;
            }

                .warning-box h4 {
                    font-weight: 700;
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    margin-bottom: 15px;
                }

                .warning-box ul {
                    margin: 0;
                    padding-left: 20px;
                }

                .warning-box li {
                    margin-bottom: 5px;
                    font-weight: 500;
                }

            .section-title {
                font-weight: 700;
                font-size: 1.2rem;
                margin-bottom: 20px;
            }

            /* Scale Bar */
            .scale-container {
                margin-top: 40px;
                position: relative;
                padding-bottom: 20px;
            }

            .scale-bar {
                height: 40px;
                border-radius: 10px;
                display: flex;
                overflow: hidden;
            }

            .scale-segment {
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-weight: 600;
                font-size: 0.85rem;
            }

            .zaif {
                background: var(--sodiq-zaif);
            }

            .ortacha {
                background: var(--sodiq-ortacha);
            }

            .yaxshi {
                background: var(--sodiq-yaxshi);
            }

            .yuqori {
                background: var(--sodiq-yuqori);
            }

            .scale-sayoz {
                background: var(--sodiq-scale-sayoz);
                flex-grow: 35;
            }

            .scale-zaif {
                background: var(--sodiq-scale-zaif);
                flex-grow: 15;
            }

            .scale-ortacha {
                background: var(--sodiq-scale-ortacha);
                flex-grow: 17;
            }

            .scale-yaxshi {
                background: var(--sodiq-scale-yaxshi);
                flex-grow: 17;
            }

            .scale-yuqori {
                background: var(--sodiq-scale-yuqori);
                flex-grow: 16;
            }

            .scale-marker {
                position: absolute;
                top: -35px;
                transform: translateX(-50%);
                display: flex;
                flex-direction: column;
                align-items: center;
            }

            .marker-value {
                font-weight: 800;
                font-size: 1.1rem;
            }

            .marker-arrow {
                width: 0;
                height: 0;
                border-left: 6px solid transparent;
                border-right: 6px solid transparent;
                border-top: 8px solid var(--sodiq-ink);
            }

            /* Circular Progress */
            .metric-circle {
                position: relative;
                width: 120px;
                height: 120px;
                margin: 0 auto 15px;
            }

            .metric-label {
                text-align: center;
                font-weight: 600;
                color: var(--sodiq-ink);
            }

            /* Heatmap / Calendar */
            .attendance-grid {
                display: flex;
                gap: 4px;
                flex-wrap: wrap;
            }

            .attendance-day {
                width: 60px;
                height: 60px;
                border-radius: 8px;
            }

            .day-keldi {
                background: var(--sodiq-yuqori);
            }

            .day-kelmadi {
                background: var(--sodiq-zaif);
            }

            .day-kech {
                background: var(--sodiq-ortacha);
            }

            .day-sababli {
                background: var(--sodiq-yaxshi);
            }

            .legend-item {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 0.85rem;
                color: var(--sodiq-muted);
            }

            .legend-color {
                width: 14px;
                height: 14px;
                border-radius: 3px;
            }

            /* Achievement Badge */
            .badge-achievement {
                background: #E6F4F1;
                color: var(--sodiq-primary);
                border-radius: 30px;
                padding: 8px 16px;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                font-weight: 600;
                font-size: 0.9rem;
            }
    </style>
</head>
<body>

    <div class="container">
        <div class="max-width-900 mx-auto">

            <a href="#" class="back-link"><i class="bi bi-arrow-left"></i> Guruhlar</a>

            <div class="profile-header">
                <div class="avatar">@initials</div>
                <div class="profile-info">
                    <h1>@Model.StudentName</h1>
                    <p>@Model.GroupName · Guruhda @Model.GroupRank / @Model.GroupSize o'rin</p>
                </div>
            </div>

            @if (Model.StatusZone == "Red" || Model.OverallScore < 40)
            {
                <div class="warning-box">
                    <h4><i class="bi bi-exclamation-triangle-fill"></i> Zudlik bilan yordam kerak</h4>
                    <ul>
                        @if (Model.StatusReasons != null && Model.StatusReasons.Any())
                        {
                            @foreach (var reason in Model.StatusReasons)
                            {
                                <li>@reason</li>
                            }
                        }
                        else
                        {
                            <li>Ball past — @Math.Round(Model.GradeScore, 0)%</li>
                            <li>Davomat — @Math.Round(Model.AttendancePercentage, 0)%</li>
                            <li>Topshiriqlar — @Math.Round(Model.AssignmentCompletionPercentage, 0)%</li>
                        }
                    </ul>
                </div>
            }

            <div class="report-card">
                <h3 class="section-title">Umumiy ko'rsatkich — @Math.Round(Model.OverallScore, 0)</h3>
                <div class="scale-container">
                    <div class="scale-marker" style="left: @Model.OverallScore%;">
                        <div class="marker-value">@Math.Round(Model.OverallScore, 0)</div>
                        <div class="marker-arrow"></div>
                    </div>
                    <div class="scale-bar">
                        <div class="scale-segment scale-sayoz">Sayoz</div>
                        <div class="scale-segment scale-zaif">Zaif</div>
                        <div class="scale-segment scale-ortacha">O'rtacha</div>
                        <div class="scale-segment scale-yaxshi">Yaxshi</div>
                        <div class="scale-segment scale-yuqori">Juda yuqori</div>
                    </div>
                </div>
            </div>

            <div class="report-card">
                <h3 class="section-title">3 asosiy ko'rsatkich</h3>
                <div class="row text-center">
                    <div class="col-4">
                        <div class="metric-circle">
                            <canvas id="chartBall"></canvas>
                        </div>
                        <div class="metric-label">Ball</div>
                    </div>
                    <div class="col-4">
                        <div class="metric-circle">
                            <canvas id="chartDavomat"></canvas>
                        </div>
                        <div class="metric-label">Davomat</div>
                    </div>
                    <div class="col-4">
                        <div class="metric-circle">
                            <canvas id="chartTopshiriqlar"></canvas>
                        </div>
                        <div class="metric-label">Topshiriqlar</div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="report-card h-100">
                        <h3 class="section-title">Ko'rsatkichlar profili</h3>
                        <canvas id="radarChart"></canvas>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="report-card h-100">
                        <h3 class="section-title">Trend — oxirgi haftalar</h3>
                        <canvas id="lineChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="report-card">
                <h3 class="section-title">Fanlar bo'yicha o'zlashtirish</h3>
                @foreach (var sub in Model.SubjectBreakdown)
                {
                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="fw-medium">@sub.SubjectName</span>
                            <span class="fw-bold">@Math.Round(sub.Percentage, 0)%</span>
                        </div>
                        <div class="progress" style="height: 8px; background-color: #EEF2F1; border-radius: 10px;">
                            <div class="progress-bar" role="progressbar" style="width: @sub.Percentage%; background-color: var(--sodiq-primary); border-radius: 10px;"></div>
                        </div>
                    </div>
                }
            </div>

            <div class="report-card">
                <h3 class="section-title">Davomat — so'nggi 30 kun</h3>
                <div class="attendance-grid mb-3">
                    @foreach (var day in Model.AttendanceCalendar)
                    {
                        var statusClass = day.Status switch
                        {
                            "Keldi" => "day-keldi",
                            "Kelmadi" => "day-kelmadi",
                            "KechQoldi" => "day-kech",
                            "Sababli" => "day-sababli",
                            _ => ""
                        };
                        <div class="attendance-day @statusClass" title="@day.Date.ToShortDateString(): @day.Status"></div>
                    }
                </div>
                <div class="d-flex gap-3">
                    <div class="legend-item"><div class="legend-color day-keldi"></div> Keldi</div>
                    <div class="legend-item"><div class="legend-color day-kelmadi"></div> Kelmadi</div>
                    <div class="legend-item"><div class="legend-color day-kech"></div> Kech qoldi</div>
                    <div class="legend-item"><div class="legend-color day-sababli"></div> Sababli</div>
                </div>
            </div>

            <div class="report-card">
                <h3 class="section-title">Yutuqlar</h3>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var badge in Model.Badges)
                    {
                        <div class="badge-achievement">
                            <i class="bi bi-patch-check-fill"></i> @badge
                        </div>
                    }
                    @if (!Model.Badges.Any())
                    {
                        <div class="badge-achievement">
                            <i class="bi bi-patch-check-fill"></i> Hech qachon kechikmagan
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>

    <script>
            // Helper to create doughnut charts
            function createDoughnut(id, value, color) {
                new Chart(document.getElementById(id), {
                    type: 'doughnut',
                    data: {
                        datasets: [{
                            data: [value, 100 - value],
                            backgroundColor: [color, '#EEF2F1'],
                            borderWidth: 0,
                            circumference: 360,
                            rotation: 0
                        }]
                    },
                    options: {
                        cutout: '75%',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: { enabled: false }
                        }
                    },
                    plugins: [{
                        id: 'centerText',
                        beforeDraw: function(chart) {
                            var width = chart.width, height = chart.height, ctx = chart.ctx;
                            ctx.restore();
                            ctx.font = "bold 1.2rem Inter";
                            ctx.textBaseline = "middle";
                            ctx.fillStyle = "#1C2321";
                            var text = value + "%", textX = Math.round((width - ctx.measureText(text).width) / 2), textY = height / 2;
                            ctx.fillText(text, textX, textY);
                            ctx.save();
                        }
                    }]
                });
            }

            createDoughnut('chartBall', @Model.GradeScore, '#346077');
            createDoughnut('chartDavomat', @Model.AttendancePercentage, '#346077');
            createDoughnut('chartTopshiriqlar', @Model.AssignmentCompletionPercentage, '#346077');

            // Radar Chart
            new Chart(document.getElementById('radarChart'), {
                type: 'radar',
                data: {
                    labels: ['Ball', 'Davomat', 'Topshiriqlar', 'Trend'],
                    datasets: [{
                        label: 'Ko\'rsatkichlar',
                        data: [@Model.GradeScore, @Model.AttendancePercentage, @Model.AssignmentCompletionPercentage, @(50 + Model.TrendScore / 2)],
                        backgroundColor: 'rgba(14, 124, 102, 0.2)',
                        borderColor: '#0E7C66',
                        pointBackgroundColor: '#0E7C66',
                        borderWidth: 2
                    }]
                },
                options: {
                    scales: {
                        r: {
                            min: 0, max: 100,
                            ticks: { display: false }
                        }
                    },
                    plugins: { legend: { display: false } }
                }
            });

            // Line Chart
            new Chart(document.getElementById('lineChart'), {
                type: 'line',
                data: {
                    labels: [@Html.Raw(string.Join(",", Model.WeeklyTrend.Select(t => "'" + t.WeekStart.ToString("dd.MM") + "'")))],
                    datasets: [{
                        data: [@string.Join(",", Model.WeeklyTrend.Select(t => t.AveragePercentage))],
                        borderColor: '#0E7C66',
                        backgroundColor: '#0E7C66',
                        tension: 0.4,
                        pointRadius: 4
                    }]
                },
                options: {
                    scales: {
                        y: { min: 0, max: 100 },
                        x: { grid: { display: false } }
                    },
                    plugins: { legend: { display: false } }
                }
            });
    </script>

</body>
</html>
