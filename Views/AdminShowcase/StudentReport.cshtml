@model EduTrack.ViewModels.StudentShowcaseViewModel
@{
    Layout = null;
    ViewData["Title"] = Model.StudentName + " - Diagnostik hisobot";
    var initials = string.Join("", Model.StudentName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(s => s[0]));

    var overall = Math.Round(Model.OverallScore, 0);
    var zoneLabel = Model.StatusZone switch
    {
        "Green" => "Yaxshi",
        "Yellow" => "O'rtacha",
        "Red" => "E'tibor kerak",
        _ => "Ma'lumot yo'q"
    };
    var zoneClass = Model.StatusZone switch
    {
        "Green" => "is-green",
        "Yellow" => "is-yellow",
        "Red" => "is-red",
        _ => "is-muted"
    };
}

<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --rp-bg: #F7F9F8;
            --rp-surface: #FFFFFF;
            --rp-ink: #1C2321;
            --rp-muted: #5A6663;
            --rp-primary: #0E7C66;
            --rp-primary-tint: #E6F4F1;
            --rp-border: #DDE5E2;
            --rp-danger: #C0392B;
            --rp-danger-bg: #FBEAE8;
            --rp-warning: #B5790E;
            --rp-warning-bg: #FDF3E0;
            --rp-radius: 20px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--rp-bg);
            color: var(--rp-ink);
            padding: 40px 0;
        }

        .report-shell { max-width: 960px; margin: 0 auto; }

        .back-link {
            color: var(--rp-muted);
            text-decoration: none;
            font-size: .9rem;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 20px;
        }

        .report-card {
            background: var(--rp-surface);
            border-radius: var(--rp-radius);
            padding: 28px;
            box-shadow: 0 4px 20px rgba(28, 35, 33, .06);
            border: 1px solid var(--rp-border);
            margin-bottom: 24px;
        }

        .profile-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 26px;
        }

        .avatar {
            width: 84px;
            height: 84px;
            background: var(--rp-primary-tint);
            color: var(--rp-primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.7rem;
            font-weight: 800;
            font-family: 'Manrope', sans-serif;
            flex-shrink: 0;
        }

        .profile-info h1 {
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
            font-size: clamp(1.6rem, 5vw, 2.2rem);
            margin: 0;
        }

        .profile-info p { color: var(--rp-muted); margin: 4px 0 0; }

        .zone-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            padding: 6px 14px;
            font-weight: 700;
            font-size: .82rem;
            margin-top: 10px;
        }

        .zone-pill.is-green { background: var(--rp-primary-tint); color: var(--rp-primary); }
        .zone-pill.is-yellow { background: var(--rp-warning-bg); color: var(--rp-warning); }
        .zone-pill.is-red { background: var(--rp-danger-bg); color: var(--rp-danger); }
        .zone-pill.is-muted { background: #EEF2F1; color: var(--rp-muted); }

        .overall-row {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 28px;
        }

        .score-ring {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            background: conic-gradient(var(--rp-primary) calc(@overall * 1%), #EEF2F1 0);
        }

        .score-ring__inner {
            width: 118px;
            height: 118px;
            border-radius: 50%;
            background: var(--rp-surface);
            display: grid;
            place-items: center;
            text-align: center;
        }

        .score-ring__value {
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
            font-size: 2.3rem;
            line-height: 1;
        }

        .score-ring__label { font-size: .72rem; color: var(--rp-muted); }

        .overall-copy { flex: 1; min-width: 220px; }

        .overall-copy h3 {
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
            margin: 0 0 6px;
        }

        .overall-copy p { color: var(--rp-muted); margin: 0; }

        .reasons { margin: 14px 0 0; padding-left: 18px; color: var(--rp-muted); font-size: .9rem; }
        .reasons li { margin-bottom: 4px; }

        .warning-box {
            background: var(--rp-danger-bg);
            color: var(--rp-danger);
            border-radius: var(--rp-radius);
            padding: 20px 24px;
            margin-bottom: 24px;
        }

        .warning-box h4 { font-weight: 700; display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-size: 1.05rem; }
        .warning-box ul { margin: 0; padding-left: 20px; }

        .section-title {
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
            font-size: 1.15rem;
            margin-bottom: 18px;
        }

        .subject-row { margin-bottom: 20px; }
        .subject-row:last-child { margin-bottom: 0; }

        .subject-row__head {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 12px;
            margin-bottom: 8px;
        }

        .subject-row__name { font-weight: 600; }
        .subject-row__meta { color: var(--rp-muted); font-size: .78rem; }

        .subject-row__score {
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
            font-size: 1.05rem;
        }

        .subject-bar {
            height: 9px;
            border-radius: 999px;
            background: #EEF2F1;
            overflow: hidden;
        }

        .subject-bar span {
            display: block;
            height: 100%;
            border-radius: 999px;
            background: var(--rp-primary);
        }

        .subject-bar span.is-fair { background: #D9A02B; }
        .subject-bar span.is-low { background: var(--rp-danger); }

        .empty-line { color: var(--rp-muted); }

        .attendance-grid { display: flex; gap: 5px; flex-wrap: wrap; }

        .attendance-day {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: #EEF2F1;
        }

        .day-keldi { background: var(--rp-primary); }
        .day-kelmadi { background: var(--rp-danger); }
        .day-kech { background: #D9A02B; }
        .day-sababli { background: #3E6A85; }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: .85rem;
            color: var(--rp-muted);
        }

        .legend-color { width: 14px; height: 14px; border-radius: 3px; }

        .badge-achievement {
            background: var(--rp-primary-tint);
            color: var(--rp-primary);
            border-radius: 999px;
            padding: 8px 16px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            font-size: .88rem;
        }

        .table > :not(caption) > * > * { padding: .7rem .6rem; }
        .table thead th { color: var(--rp-muted); font-weight: 600; font-size: .8rem; border-bottom-width: 1px; }
        .table tbody td { border-color: #EDF1EF; }
    </style>
</head>
<body>

    <div class="container">
        <div class="report-shell">

            <a href="@(ViewBag.BackUrl ?? "#")" class="back-link">
                <i class="bi bi-arrow-left"></i> @(ViewBag.BackText ?? "Guruhlar")
            </a>

            <div class="profile-header">
                <div class="avatar">@initials</div>
                <div class="profile-info">
                    <h1>@Model.StudentName</h1>
                    <p>
                        @(string.IsNullOrWhiteSpace(Model.GroupName) ? "Guruh belgilanmagan" : Model.GroupName)
                        @if (Model.GroupSize > 0)
                        {
                            <span> · Guruhda @Model.GroupRank / @Model.GroupSize o'rin</span>
                        }
                    </p>
                    <span class="zone-pill @zoneClass">
                        <i class="bi bi-activity"></i> @zoneLabel
                    </span>
                </div>
            </div>

            @if (Model.StatusZone == "Red")
            {
                <div class="warning-box">
                    <h4><i class="bi bi-exclamation-triangle-fill"></i> E'tibor talab qiladi</h4>
                    <ul>
                        @foreach (var reason in Model.StatusReasons)
                        {
                            <li>@reason</li>
                        }
                    </ul>
                </div>
            }

            <div class="report-card">
                <div class="overall-row">
                    <div class="score-ring">
                        <div class="score-ring__inner">
                            <div>
                                <div class="score-ring__value">@overall</div>
                                <div class="score-ring__label">/ 100</div>
                            </div>
                        </div>
                    </div>
                    <div class="overall-copy">
                        <h3>Umumiy baho</h3>
                        <p>
                            Fanlar bo'yicha 100 ballik yakuniy baholarning o'rtachasi.
                            Qo'lda qo'yilgan baho ustuvor, aks holda tasdiqlangan
                            imtihon natijalarining o'rtachasi hisoblanadi.
                        </p>
                        <ul class="reasons">
                            @foreach (var reason in Model.StatusReasons)
                            {
                                <li>@reason</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <div class="report-card">
                <h3 class="section-title">Fanlar bo'yicha yakuniy baholar</h3>

                @if (Model.SubjectBreakdown.Count == 0)
                {
                    <p class="empty-line mb-0">Hozircha fan baholari kiritilmagan.</p>
                }
                else
                {
                    @foreach (var subject in Model.SubjectBreakdown)
                    {
                        var barClass = subject.Percentage < 55 ? "is-low"
                            : subject.Percentage < 71 ? "is-fair"
                            : "";

                        <div class="subject-row">
                            <div class="subject-row__head">
                                <div>
                                    <div class="subject-row__name">@subject.SubjectName</div>
                                    <div class="subject-row__meta">
                                        @(subject.Percentage >= 86 ? "A'lo"
                                            : subject.Percentage >= 71 ? "Yaxshi"
                                            : subject.Percentage >= 55 ? "Qoniqarli"
                                            : "Qoniqarsiz")
                                    </div>
                                </div>
                                <div class="subject-row__score">@subject.Percentage.ToString("0.#")</div>
                            </div>
                            <div class="subject-bar">
                                <span class="@barClass" style="width: @Math.Clamp(subject.Percentage, 0, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%;"></span>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="report-card">
                <h3 class="section-title">Davomat — so'nggi 30 kun</h3>

                @if (Model.AttendanceCalendar.Count == 0)
                {
                    <p class="empty-line mb-0">Davomat yozuvlari yo'q.</p>
                }
                else
                {
                    <div class="attendance-grid mb-3">
                        @foreach (var day in Model.AttendanceCalendar)
                        {
                            var statusClass = day.Status switch
                            {
                                "Keldi" => "day-keldi",
                                "Kelmadi" => "day-kelmadi",
                                "KechQoldi" => "day-kech",
                                "Sababli" => "day-sababli",
                                _ => ""
                            };
                            <div class="attendance-day @statusClass" title="@day.Date.ToShortDateString(): @day.Status"></div>
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-3">
                        <div class="legend-item"><div class="legend-color day-keldi"></div> Keldi</div>
                        <div class="legend-item"><div class="legend-color day-kelmadi"></div> Kelmadi</div>
                        <div class="legend-item"><div class="legend-color day-kech"></div> Kech qoldi</div>
                        <div class="legend-item"><div class="legend-color day-sababli"></div> Sababli</div>
                    </div>
                }
            </div>

            <div class="report-card">
                <h3 class="section-title">Yutuqlar</h3>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var badge in Model.Badges)
                    {
                        <div class="badge-achievement">
                            <i class="bi bi-patch-check-fill"></i> @badge
                        </div>
                    }
                    @if (!Model.Badges.Any())
                    {
                        <div class="badge-achievement">
                            <i class="bi bi-info-circle"></i> Hozircha yutuq qayd etilmagan
                        </div>
                    }
                </div>
            </div>

            @if (ViewBag.ParentExamResults is List<EduTrack.ViewModels.ParentExamResultViewModel> parentExams)
            {
                <div class="report-card">
                    <h3 class="section-title">So'nggi imtihon natijalari</h3>
                    @if (!parentExams.Any())
                    {
                        <p class="empty-line mb-0">Hozircha ma'lumot mavjud emas.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Imtihon</th>
                                        <th>Fan</th>
                                        <th>Natija</th>
                                        <th>Foiz</th>
                                        <th>Sana</th>
                                        <th>Holat</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var exam in parentExams)
                                    {
                                        <tr>
                                            <td>@exam.ExamTitle</td>
                                            <td>@(exam.SubjectName ?? "-")</td>
                                            <td>@exam.CorrectAnswers / @exam.TotalQuestions</td>
                                            <td>@exam.Percentage%</td>
                                            <td>@exam.CompletedDate.ToString("dd.MM.yyyy")</td>
                                            <td>
                                                <span class="badge @exam.StatusClass">@exam.StatusLabel</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }

        </div>
    </div>

</body>
</html>
