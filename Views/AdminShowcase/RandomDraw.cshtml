@model EduTrack.ViewModels.RandomDrawViewModel
@{
    ViewData["Title"] = "Tasodifiy Talaba Navbati";
    var session = Model.ActiveSession;
}

<h1><i class="bi bi-shuffle"></i> Tasodifiy Talaba Navbati</h1>
<div class="iz-signature-line"></div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (session != null)
{
    <section class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                <h2 class="h5 mb-0">Faol sessiya</h2>
                <span class="badge @(session.Status == "Open" ? "bg-success" : "bg-secondary")">@session.StatusLabel</span>
                @if (session.GroupNames.Any())
                {
                    <span class="text-muted small">Guruhlar: @string.Join(", ", session.GroupNames)</span>
                }
                <span class="text-muted small">Qolgan nomzodlar: @session.RemainingEligibleCount</span>
                <span class="text-muted small">Jami tanlangan: @session.TotalParticipants</span>
            </div>

            <div class="row g-3">
                @if (session.Current != null)
                {
                    <div class="col-md-6">
                        <div class="card border-0 h-100 iz-current-card">
                            <div class="card-body">
                                <div class="text-muted small text-uppercase mb-1">Hozir taqdimot qilmoqda</div>
                                <div class="fs-5 fw-bold mb-1">@session.Current.StudentName</div>
                                <a asp-action="StudentReport" asp-route-studentId="@session.Current.StudentId" class="btn btn-outline-primary btn-sm mb-3">
                                    <i class="bi bi-file-earmark-bar-graph"></i> Hisobot
                                </a>

                                @if (session.Status == "Open")
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        <form asp-action="Finalize" method="post" class="d-inline">
                                            <input type="hidden" name="sessionId" value="@session.SessionId" />
                                            <input type="hidden" name="participantId" value="@session.Current.ParticipantId" />
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="bi bi-check2-circle"></i> Yakunlash
                                            </button>
                                        </form>

                                        <form asp-action="Skip" method="post" class="d-flex gap-2">
                                            <input type="hidden" name="sessionId" value="@session.SessionId" />
                                            <input type="hidden" name="participantId" value="@session.Current.ParticipantId" />
                                            <input type="text" name="reason" class="form-control form-control-sm" placeholder="Sabab" required />
                                            <button type="submit" class="btn btn-outline-warning btn-sm text-nowrap">
                                                <i class="bi bi-skip-forward"></i> O'tkazib yuborish
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <div class="col-md-6">
                    <div class="card border-0 h-100 iz-next-card">
                        <div class="card-body">
                            <div class="text-muted small text-uppercase mb-1">Keyingi navbat</div>
                            @if (session.Next != null)
                            {
                                <div class="fs-5 fw-bold mb-1">@session.Next.StudentName</div>
                                <span class="badge bg-light text-dark">@session.Next.StatusLabel</span>
                            }
                            else
                            {
                                <div class="text-muted">Hozircha navbatda hech kim yo'q.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (session.Status != "Open" && session.Current == null && session.Next == null)
            {
                <div class="iz-empty mt-3">
                    <i class="bi bi-check2-all"></i>
                    <p>Sessiya yakunlandi.</p>
                </div>
            }
        </div>
    </section>
}

<section>
    <h2 class="h5">Yangi sessiya boshlash</h2>
    <p class="text-muted">Bir yoki bir nechta guruhni tanlang — server Current va Next talabani tasodifiy zaxiralaydi.</p>

    <form asp-action="RandomDraw" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        @if (!Model.Groups.Any())
        {
            <div class="iz-empty">
                <i class="bi bi-people"></i>
                <p>Hozircha guruhlar mavjud emas.</p>
            </div>
        }
        else
        {
            <div class="row g-3 mb-4">
                @foreach (var group in Model.Groups)
                {
                    var isChecked = Model.SelectedGroupIds.Contains(group.Id);
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <label class="card shadow-sm border-0 rounded-4 h-100 iz-draw-card">
                            <div class="card-body d-flex align-items-center gap-3">
                                <input type="checkbox" name="groupIds" value="@group.Id" class="form-check-input mt-0" @(isChecked ? "checked" : "") />
                                <div>
                                    <div class="fw-semibold">@group.Name</div>
                                    <div class="text-muted small">@group.Students.Count ta talaba</div>
                                </div>
                            </div>
                        </label>
                    </div>
                }
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-shuffle"></i> Sessiyani boshlash
            </button>
        }
    </form>
</section>

<style>
    .iz-draw-card {
        cursor: pointer;
        transition: box-shadow .15s ease, border-color .15s ease;
    }

        .iz-draw-card:hover {
            box-shadow: 0 8px 24px rgba(28, 35, 33, 0.12) !important;
        }

        .iz-draw-card:has(input:checked) {
            border: 1px solid var(--iz-primary);
            background-color: var(--iz-primary-tint);
        }

    .iz-current-card {
        background-color: var(--iz-primary-tint);
        border: 1px solid var(--iz-primary) !important;
    }

    .iz-next-card {
        background-color: #FBF7EE;
        border: 1px dashed #D4A017 !important;
    }
</style>
