@{
    ViewData["Title"] = "Davomat";
}

<h1>Davomat belgilash</h1>

<form asp-action="Mark" method="get" class="row g-3 mt-2">
    <div class="col-md-4">
        <label class="control-label">Fan</label>
        <select name="subjectId" class="form-control" asp-items="ViewBag.Subjects">
            <option value="">-- Tanlang --</option>
        </select>
    </div>
    <div class="col-md-4">
        <label class="control-label">Guruh</label>
        <select name="groupId" class="form-control" asp-items="ViewBag.Groups">
            <option value="">-- Tanlang --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="control-label">Sana</label>
        <input type="date" name="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-1 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">O'tish</button>
    </div>
</form>