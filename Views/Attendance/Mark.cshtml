@model IEnumerable<EduTrack.Models.ApplicationUser>
@{
    ViewData["Title"] = "Davomat belgilash";
    var existingRecords = ViewBag.ExistingRecords as Dictionary<string, AttendanceStatus>;
}

@functions {
    string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "?";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    string GetAvatarColor(string? fullName)
    {
        int hash = 0;
        foreach (var c in (fullName ?? "?")) hash = c + ((hash << 5) - hash);
        int hue = Math.Abs(hash) % 360;
        return $"hsl({hue}, 60%, 42%)";
    }
}

<style>
    .iz-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 600;
        font-size: .78rem;
        flex-shrink: 0;
    }

    .attendance-card {
        border: none;
        border-radius: .75rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
    }
</style>

<h1>@ViewBag.SubjectName — @(((DateTime)ViewBag.Date).ToString("dd.MM.yyyy"))</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.Any())
{
    <div class="iz-empty"><i class="bi bi-people"></i><p>Bu guruhda hech qanday talaba yo'q.</p></div>
}
else
{
    <!-- Jonli hisoblagich kartalar -->
    <div class="row g-2 mb-3">
        <div class="col-6 col-md">
            <div class="card attendance-card text-center">
                <div class="card-body py-2">
                    <div class="small text-muted">Jami</div>
                    <div class="fs-4 fw-bold" id="countTotal">0</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card attendance-card text-center">
                <div class="card-body py-2">
                    <div class="small text-muted">Keldi</div>
                    <div class="fs-4 fw-bold text-success" id="countKeldi">0</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card attendance-card text-center">
                <div class="card-body py-2">
                    <div class="small text-muted">Kelmadi</div>
                    <div class="fs-4 fw-bold text-danger" id="countKelmadi">0</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card attendance-card text-center">
                <div class="card-body py-2">
                    <div class="small text-muted">Kech qoldi</div>
                    <div class="fs-4 fw-bold text-warning" id="countKechQoldi">0</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card attendance-card text-center">
                <div class="card-body py-2">
                    <div class="small text-muted">Sababli</div>
                    <div class="fs-4 fw-bold text-info" id="countSababli">0</div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
        <input type="text" id="studentSearch" class="form-control" style="max-width:280px" placeholder="Talaba qidirish..." />
        <button type="button" id="markAllPresentBtn" class="btn btn-success">
            <i class="bi bi-check2-all"></i> Hammasini Keldi deb belgilash
        </button>
    </div>

    <form asp-action="Save" method="post" class="mt-3" id="attendanceForm">
        <input type="hidden" name="subjectId" value="@ViewBag.SubjectId" />
        <input type="hidden" name="groupId" value="@ViewBag.GroupId" />
        <input type="hidden" name="date" value="@(((DateTime)ViewBag.Date).ToString("yyyy-MM-dd"))" />

        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Talaba</th>
                        <th class="text-center">Holat</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model)
                    {
                        AttendanceStatus? status = existingRecords != null && existingRecords.ContainsKey(student.Id)
                            ? existingRecords[student.Id]
                            : (AttendanceStatus?)null;

                        <tr class="attendance-row" data-name="@((student.FullName ?? "").ToLower())">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="iz-avatar" style="background-color:@GetAvatarColor(student.FullName)">@GetInitials(student.FullName)</span>
                                    <span>@student.FullName</span>
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="btn-group status-group" role="group" data-student-id="@student.Id">
                                    <button type="button" class="btn btn-outline-success status-btn @(status == AttendanceStatus.Keldi ? "active" : "")" data-status="Keldi">Keldi</button>
                                    <button type="button" class="btn btn-outline-danger status-btn @(status == AttendanceStatus.Kelmadi ? "active" : "")" data-status="Kelmadi">Kelmadi</button>
                                    <button type="button" class="btn btn-outline-warning status-btn @(status == AttendanceStatus.KechQoldi ? "active" : "")" data-status="KechQoldi">Kech qoldi</button>
                                    <button type="button" class="btn btn-outline-info status-btn @(status == AttendanceStatus.Sababli ? "active" : "")" data-status="Sababli">Sababli</button>
                                </div>
                                <input type="hidden" name="statuses[@student.Id]" class="status-input" value="@(status?.ToString() ?? "")" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <button type="submit" class="btn btn-success">Saqlash</button>
        <a asp-action="Index" class="btn btn-secondary">Orqaga</a>
    </form>
}

@section Scripts {
    <script>
        (function() {
            function updateCounts() {
                const counts = { Keldi: 0, Kelmadi: 0, KechQoldi: 0, Sababli: 0 };
                document.querySelectorAll('.status-group').forEach(function(group) {
                    const active = group.querySelector('.status-btn.active');
                    if (active) counts[active.dataset.status]++;
                });
                document.getElementById('countTotal').textContent = document.querySelectorAll('.status-group').length;
                document.getElementById('countKeldi').textContent = counts.Keldi;
                document.getElementById('countKelmadi').textContent = counts.Kelmadi;
                document.getElementById('countKechQoldi').textContent = counts.KechQoldi;
                document.getElementById('countSababli').textContent = counts.Sababli;
            }

            function setStatus(group, status) {
                group.querySelectorAll('.status-btn').forEach(function(btn) {
                    btn.classList.remove('active');
                });
                const btn = group.querySelector('.status-btn[data-status="' + status + '"]');
                if (btn) btn.classList.add('active');

                const studentId = group.dataset.studentId;
                const input = document.querySelector('input.status-input[name="statuses[' + studentId + ']"]');
                if (input) input.value = status;
            }

            document.querySelectorAll('.status-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    const group = btn.closest('.status-group');
                    setStatus(group, btn.dataset.status);
                    updateCounts();
                });
            });

            const markAllBtn = document.getElementById('markAllPresentBtn');
            if (markAllBtn) {
                markAllBtn.addEventListener('click', function() {
                    document.querySelectorAll('.status-group').forEach(function(group) {
                        setStatus(group, 'Keldi');
                    });
                    updateCounts();
                });
            }

            const searchInput = document.getElementById('studentSearch');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    const query = this.value.trim().toLowerCase();
                    document.querySelectorAll('.attendance-row').forEach(function(row) {
                        row.style.display = row.dataset.name.includes(query) ? '' : 'none';
                    });
                });
            }

            const form = document.getElementById('attendanceForm');
            if (form) {
                form.addEventListener('submit', function(e) {
                    let unsetCount = 0;
                    document.querySelectorAll('.status-input').forEach(function(inp) {
                        if (!inp.value) unsetCount++;
                    });
                    if (unsetCount > 0) {
                        const ok = confirm(unsetCount + " ta talabaning holati belgilanmagan. Ular \"Kelmadi\" deb saqlanadi. Davom etasizmi?");
                        if (!ok) e.preventDefault();
                    }
                });
            }

            updateCounts();
        })();
    </script>
}