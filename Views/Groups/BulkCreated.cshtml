@model List<EduTrack.ViewModels.UserCredentialsViewModel>

@{
    ViewData["Title"] = "Talabalar yaratildi";
}

<h1>Talabalar muvaffaqiyatli yaratildi</h1>

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle"></i>
    Bu ro'yxat faqat <strong>hozir, shu sahifada</strong> ko'rinadi — parollarni qayta ko'rish imkoni bo'lmaydi.
    Hozir nusxalab yoki ekran suratini olib saqlab qo'ying.
</div>

<p><strong>Guruh:</strong> @ViewBag.GroupName &nbsp;|&nbsp; <strong>Yaratilgan talabalar:</strong> @Model.Count</p>

<div class="table-responsive">
    <table class="table table-bordered align-middle">
        <thead>
            <tr>
                <th>Ism-familiya</th>
                <th>Login ID</th>
                <th>Parol</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FullName</td>
                    <td><code>@item.LoginId</code></td>
                    <td><code>@item.Password</code></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3">
    <a asp-action="BulkCreate" class="btn btn-primary">
        <i class="bi bi-people"></i> Yana guruh qo'shish
    </a>
    <a asp-action="Index" class="btn btn-secondary">Guruhlar ro'yxatiga qaytish</a>

    <form asp-action="ExportExcel" method="post" class="d-inline">
        <input type="hidden" name="groupName" value="@ViewBag.GroupName" />
        @foreach (var item in Model)
        {
            <input type="hidden" name="fullNames" value="@item.FullName" />
            <input type="hidden" name="loginIds" value="@item.LoginId" />
            <input type="hidden" name="passwords" value="@item.Password" />
        }
        <button type="submit" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel"></i> Excel'ga yuklab olish
        </button>
    </form>
</div>