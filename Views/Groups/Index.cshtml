@model IEnumerable<EduTrack.Models.Group>

@{
    ViewData["Title"] = "Guruhlar";
    var memberCounts = ViewBag.MemberCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var isAdmin = User.IsInRole("Admin");
}

<h1>Guruhlar</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">+ Yangi guruh qo'shish</a>
    @if (isAdmin)
    {
        <a asp-controller="Users" asp-action="BulkCreate" class="btn btn-outline-primary">
            <i class="bi bi-people"></i> Talabalarni ommaviy qo'shish
        </a>
    }
</p>

@if (!Model.Any())
{
    <div class="iz-empty"><i class="bi bi-people"></i><p>Hozircha guruhlar yo'q. Yuqoridagi tugma orqali birinchi guruhni yarating.</p></div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Guruh nomi</th>
                    <th>Turi</th>
                    <th>Talabalar soni</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var count = memberCounts.TryGetValue(item.Id, out var n) ? n : 0;
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="fw-semibold text-decoration-none">
                                @item.Name
                            </a>
                        </td>
                        <td>
                            @if (item.Type == EduTrack.Models.GroupType.Class)
                            {
                                <span class="badge bg-primary">Sinf</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">Guruh</span>
                            }
                        </td>
                        <td>@count</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-people"></i> O'quvchilar
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Tahrirlash</a>
                            @if (isAdmin)
                            {
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">O'chirish</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}