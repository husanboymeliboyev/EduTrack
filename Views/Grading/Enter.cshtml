@model List<EduTrack.ViewModels.StudentGradeRowViewModel>
@{
    ViewData["Title"] = "Baho qo'yish";
    var subjectName = ViewBag.SubjectName as string ?? "Fan";
    var groupName = ViewBag.GroupName as string ?? "Guruh";
    var graded = Model.Count(s => s.HasScore);
}

<div class="iz-page-head">
    <div>
        <a class="iz-back-link" asp-action="Index">
            <i class="bi bi-arrow-left"></i> Baholash
        </a>
        <h1 class="mb-1">@subjectName</h1>
        <p class="text-muted mb-0">
            <i class="bi bi-people"></i> @groupName · @Model.Count o'quvchi · @graded baholangan
        </p>
    </div>
    <span class="iz-grade-pill"><i class="bi bi-shield-check"></i> 0–100 ball</span>
</div>
<div class="iz-signature-line"></div>

<div class="iz-grade-note">
    <i class="bi bi-lightbulb"></i>
    <div>
        <b>Baholash qoidasi:</b> qo'lda kiritilgan ball ustuvor. Maydon bo'sh
        qoldirilsa, fan bo'yicha tasdiqlangan imtihon natijalarining o'rtachasi
        ko'rsatiladi. Davomat va topshiriqlar bu bahoga ta'sir qilmaydi.
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 rounded-4">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning border-0 rounded-4">@TempData["Error"]</div>
}
@if (TempData["Info"] != null)
{
    <div class="alert alert-info border-0 rounded-4">@TempData["Info"]</div>
}

@if (!Model.Any())
{
    <div class="iz-empty mt-4">
        <i class="bi bi-people"></i>
        <p>Bu guruhda hech qanday o'quvchi yo'q.</p>
    </div>
}
else
{
    <form asp-action="SaveGrades" method="post" id="gradesForm">
        <input type="hidden" name="subjectId" value="@ViewBag.SubjectId" />
        <input type="hidden" name="groupId" value="@ViewBag.GroupId" />

        <div class="iz-grade-table-wrap">
            <table class="table iz-grade-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:56px;">#</th>
                        <th>O'quvchi</th>
                        <th class="text-center d-none d-sm-table-cell" style="width:150px;">Imtihon o'rtachasi</th>
                        <th class="text-center" style="width:170px;">Qo'lda baho</th>
                        <th class="text-center" style="width:130px;">Yakuniy</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var index = 0; }
                    @foreach (var row in Model)
                    {
                        index++;
                        <tr data-student="@row.StudentId">
                            <td class="text-muted">@index</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="iz-grade-avatar">@(string.IsNullOrWhiteSpace(row.StudentName) ? "?" : row.StudentName.Trim().Substring(0, 1).ToUpperInvariant())</span>
                                    <span class="fw-semibold">@row.StudentName</span>
                                </div>
                            </td>
                            <td class="text-center d-none d-sm-table-cell">
                                @if (row.ExamAverage.HasValue)
                                {
                                    <span class="iz-grade-exam">@row.ExamAverage.Value.ToString("0.#")</span>
                                    <span class="iz-grade-exam-count">@row.ExamCount ta imtihon</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <input type="number"
                                       class="form-control iz-grade-input js-grade-input"
                                       name="scores[@row.StudentId]"
                                       value="@(row.ManualScore?.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))"
                                       min="0" max="100" step="0.1"
                                       placeholder="—"
                                       data-exam="@(row.ExamAverage?.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) ?? "")" />
                            </td>
                            <td class="text-center">
                                <span class="iz-grade-final js-grade-final">
                                    @(row.HasScore ? row.EffectiveScore!.Value.ToString("0.#") : "—")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
            <span class="text-muted small">
                <i class="bi bi-info-circle"></i> Bo'sh maydon qo'lda bahoni o'zgartirmaydi.
            </span>
            <button type="submit" class="btn iz-grade-save">
                <i class="bi bi-check2-circle"></i> Baholarni saqlash
            </button>
        </div>
    </form>
}

@section Scripts {
    <script>
        (function () {
            function refresh(input) {
                var row = input.closest('tr');
                var final = row.querySelector('.js-grade-final');
                if (!final) return;

                var value = input.value.trim();
                var exam = input.dataset.exam;

                if (value !== '') {
                    final.textContent = value;
                    final.classList.add('is-manual');
                } else {
                    final.textContent = exam !== '' ? exam : '—';
                    final.classList.remove('is-manual');
                }
            }

            document.querySelectorAll('.js-grade-input').forEach(function (input) {
                input.addEventListener('input', function () { refresh(input); });
                refresh(input);
            });
        })();
    </script>
}
