@model EduTrack.Services.StudentImportPreview
@{
    ViewData["Title"] = "Import — tekshirish natijasi";
    var students = Model.Students.ToList();
    var skipped = Model.Skipped.ToList();
}

<h1>Tekshirish natijasi (dry-run)</h1>

@if (Model.Errors.Count > 0)
{
    <div class="alert alert-danger">
        <p class="fw-bold mb-1">Xatolar topildi — import o'tkazilmaydi:</p>
        <ul class="mb-0">
            @foreach (var error in Model.Errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-auto">
        <div class="card border-success">
            <div class="card-body text-center">
                <div class="display-6 text-success">@Model.StudentCount</div>
                <div class="text-muted small">O'quvchi yaratiladi</div>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card border-secondary">
            <div class="card-body text-center">
                <div class="display-6 text-secondary">@skipped.Count</div>
                <div class="text-muted small">O'tkazilgan qator</div>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card border-secondary">
            <div class="card-body text-center">
                <div class="display-6 text-secondary">@Model.SeparatorCount</div>
                <div class="text-muted small">Ajratgich qatori</div>
            </div>
        </div>
    </div>
</div>

@if (Model.CountByClass.Count > 0)
{
    <h5>Sinflar bo'yicha</h5>
    <table class="table table-sm table-bordered w-auto mb-4">
        <thead><tr><th>Sinf</th><th>Soni</th></tr></thead>
        <tbody>
            @foreach (var (name, count) in Model.CountByClass)
            {
                <tr><td>@name</td><td>@count</td></tr>
            }
        </tbody>
    </table>
}

<h5>Yaratiladigan o'quvchilar (LoginId bashorati)</h5>
<div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
    <table class="table table-sm table-striped align-middle">
        <thead><tr><th>Qator</th><th>LoginId</th><th>Ism familiya</th><th>Sinf</th><th>Guruh</th></tr></thead>
        <tbody>
            @foreach (var row in students)
            {
                <tr>
                    <td>@row.RowNumber</td>
                    <td><code>@row.AssignedLoginId</code></td>
                    <td>@row.FullName</td>
                    <td>@row.ClassName</td>
                    <td>@(row.StreamNumber.HasValue ? $"{row.StreamNumber}-guruh" : "—")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (skipped.Count > 0)
{
    <h5 class="mt-4">O'tkazib yuboriladigan qatorlar</h5>
    <table class="table table-sm table-bordered">
        <thead><tr><th>Qator</th><th>Ism familiya</th><th>Sinf</th><th>Sabab</th></tr></thead>
        <tbody>
            @foreach (var row in skipped)
            {
                <tr>
                    <td>@row.RowNumber</td>
                    <td>@(row.FullName.Length > 0 ? row.FullName : "(bo'sh)")</td>
                    <td>@row.SourceClass</td>
                    <td>@row.SkipReason</td>
                </tr>
            }
        </tbody>
    </table>
}

<form asp-action="Import" method="post" enctype="multipart/form-data" class="mt-4">
    @Html.AntiForgeryToken()
    <div class="alert alert-warning">
        Import dan keyin <strong>o'zgartirib bo'lmaydi</strong>. Faylni shu yerda qayta tanlang (bir xil fayl bo'lishi kerak).
    </div>
    <input type="file" name="ExcelFile" class="form-control mb-3" accept=".xlsx" required />
    <button type="submit" class="btn btn-primary" onclick="return confirm('Importni boshlaysizmi?');">
        <i class="bi bi-cloud-upload"></i> Import qilish
    </button>
    <a asp-action="Index" class="btn btn-secondary">Qaytish</a>
</form>
