@model List<(EduTrack.Models.Group Class, List<EduTrack.Models.ApplicationUser> Students)>
@{
    ViewData["Title"] = "Kirish varaqalari";
    Layout = null; // Chop etish uchun to'liq mustaqil sahifa
}
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kirish varaqalari — EduTrack</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { font-family: "Segoe UI", system-ui, sans-serif; font-size: 13px; }
        .sheet-page { page-break-after: always; padding: 12px 18px; }
        .sheet-page:last-child { page-break-after: auto; }
        .sheet-title { display:flex; justify-content: space-between; align-items: baseline; border-bottom: 2px solid #111; padding-bottom: 6px; margin-bottom: 10px; }
        .sheet-note { color:#444; font-size: 12px; margin-bottom: 10px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ccc; padding: 4px 6px; text-align: left; }
        th { background: #f2f2f2; }
        .no-print { padding: 8px 18px; }
        @@media print {
            .no-print { display: none !important; }
            body { font-size: 12px; }
            @@page { margin: 12mm; }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <form method="get" action="@Url.Action("EntrySheet", "StudentImport")" class="d-inline-flex gap-2 align-items-center">
            <label class="form-label mb-0" for="classGroupId">Sinf:</label>
            <select name="classGroupId" id="classGroupId" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                <option value="">— barchasi —</option>
                @foreach (var item in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.AllClasses)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            </select>
        </form>
        <button class="btn btn-primary btn-sm" onclick="window.print()"><i class="bi bi-printer"></i> Chop etish</button>
        <a class="btn btn-secondary btn-sm" href="@Url.Action("Index", "StudentImport")">Import sahifasi</a>
    </div>

    @foreach (var (cls, students) in Model)
    {
        <section class="sheet-page">
            <div class="sheet-title">
                <div>
                    <div style="font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #666;">EduTrack</div>
                    <h2 style="margin: 0; font-size: 22px;">Kirish varaqasi — @cls.Name sinfi</h2>
                </div>
                <div style="text-align: right; font-size: 12px; color: #444;">
                    @DateTime.Now.ToString("dd.MM.yyyy")
                </div>
            </div>
            <div class="sheet-note">
                <strong>Login:</strong> LoginId (quyidagi ro'yxat) &nbsp;•&nbsp;
                <strong>Vaqtincha parol:</strong> <code>parol123</code> &nbsp;•&nbsp;
                Tizimga birinchi kirishda parolni <strong>majburiy almashtiring</strong>.
            </div>
            <table>
                <thead>
                    <tr><th style="width: 40px;">#</th><th>Ism familiya</th><th style="width: 110px;">LoginId</th></tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < students.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@students[i].FullName</td>
                            <td><code>@students[i].LoginId</code></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="sheet-note" style="margin-top: 8px; border-top: 1px solid #ddd; padding-top: 6px;">
                Jami o'quvchi: <strong>@students.Count</strong>. Parolni faqat o'quvchining o'ziga bering.
            </div>
        </section>
    }
</body>
</html>
