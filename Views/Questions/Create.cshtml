@model EduTrack.ViewModels.QuestionFormViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Yangi savol";
}

<h1>Yangi savol qo'shish</h1>

<div class="alert alert-info">
    <i class="bi bi-info-circle"></i>
    Matematik formulalar uchun LaTeX yozishingiz mumkin: <code>$x^2 + y^2 = z^2$</code> —
    natijada <strong>pastdagi "Ko'rinishi" qismida</strong> jonli ko'rinadi.
</div>

<form asp-action="Create" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group mb-3">
        <label asp-for="SubjectId" class="control-label">Fan</label>
        <select asp-for="SubjectId" class="form-control" id="subjectSelect" asp-items="@(ViewBag.Subjects as SelectList)">
            <option value="">-- Fanni tanlang --</option>
        </select>
        <span asp-validation-for="SubjectId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="QuestionBankId" class="control-label">Savollar banki</label>
        <select asp-for="QuestionBankId" class="form-control" id="bankSelect">
            <option value="">-- Avval fanni tanlang --</option>
        </select>
        <span asp-validation-for="QuestionBankId" class="text-danger"></span>
        <small class="text-muted">Savol shu bankka qo'shiladi (masalan "1-oraliq"). Bank yo'q bo'lsa, avval Savollar banki bo'limida yarating.</small>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Text" class="control-label">Savol matni</label>
        <textarea asp-for="Text" class="form-control" rows="3" id="questionText"></textarea>
        <span asp-validation-for="Text" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="control-label text-muted small">Ko'rinishi (jonli):</label>
        <div id="questionPreview" class="border rounded p-3" style="min-height: 48px; background: var(--iz-bg, #f8f9fa);"></div>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ImageFile" class="control-label">Rasm (ixtiyoriy — masalan geometrik chizma)</label>
        <input asp-for="ImageFile" type="file" accept=".png,.jpg,.jpeg" class="form-control" />
        <span asp-validation-for="ImageFile" class="text-danger"></span>
    </div>

    <label class="control-label">Variantlar (kamida 2 tasini to'ldiring)</label>
    <div class="form-group mb-2 d-flex align-items-center">
        <input type="radio" name="CorrectOption" value="1" class="me-2" checked="@(Model.CorrectOption == 1)" />
        <input asp-for="Option1" class="form-control" placeholder="1-variant" />
    </div>
    <span asp-validation-for="Option1" class="text-danger"></span>

    <div class="form-group mb-2 d-flex align-items-center">
        <input type="radio" name="CorrectOption" value="2" class="me-2" checked="@(Model.CorrectOption == 2)" />
        <input asp-for="Option2" class="form-control" placeholder="2-variant" />
    </div>
    <span asp-validation-for="Option2" class="text-danger"></span>

    <div class="form-group mb-2 d-flex align-items-center">
        <input type="radio" name="CorrectOption" value="3" class="me-2" checked="@(Model.CorrectOption == 3)" />
        <input asp-for="Option3" class="form-control" placeholder="3-variant (ixtiyoriy)" />
    </div>

    <div class="form-group mb-3 d-flex align-items-center">
        <input type="radio" name="CorrectOption" value="4" class="me-2" checked="@(Model.CorrectOption == 4)" />
        <input asp-for="Option4" class="form-control" placeholder="4-variant (ixtiyoriy)" />
    </div>
    <span asp-validation-for="CorrectOption" class="text-danger"></span>
    <p class="text-muted">Radio tugmasi bilan to'g'ri javobni belgilang.</p>

    <button type="submit" class="btn btn-primary">Saqlash</button>
    <a asp-action="Index" class="btn btn-secondary">Bekor qilish</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
    <script>
        const textarea = document.getElementById('questionText');
        const preview = document.getElementById('questionPreview');

        function updatePreview() {
            preview.textContent = textarea.value || '(hozircha bo\'sh)';
            renderMathInElement(preview, {
                delimiters: [
                    { left: '$$', right: '$$', display: true },
                    { left: '$', right: '$', display: false }
                ]
            });
        }

        textarea.addEventListener('input', updatePreview);
        updatePreview();

        const subjectBanksMap = @Html.Raw(ViewBag.SubjectBanksJson ?? "{}");
        const subjectSelect = document.getElementById('subjectSelect');
        const bankSelect = document.getElementById('bankSelect');
        const currentBankId = "@Model.QuestionBankId";

        function refreshBanks() {
            const banks = subjectBanksMap[subjectSelect.value] || [];
            bankSelect.innerHTML = banks.length
                ? '<option value="">-- Bankni tanlang --</option>'
                : '<option value="">-- Bu fanda hali bank yo\'q --</option>';
            banks.forEach(function(b) {
                const opt = document.createElement('option');
                opt.value = b.id;
                opt.textContent = b.name;
                if (String(b.id) === currentBankId) opt.selected = true;
                bankSelect.appendChild(opt);
            });
        }

        subjectSelect.addEventListener('change', refreshBanks);
        refreshBanks();
    </script>
}
