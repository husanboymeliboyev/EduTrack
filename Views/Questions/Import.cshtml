@model EduTrack.ViewModels.QuestionImportUploadViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Savollarni ommaviy import qilish";
}

<h1>Savollarni ommaviy import qilish</h1>

<div class="alert alert-info">
    <i class="bi bi-info-circle"></i>
    <strong>Qanday ishlaydi:</strong>
    <ol class="mb-0 mt-2">
        <li>Avval shablonni yuklab oling</li>
        <li>Shablonni AI'ga (ChatGPT, Claude, Gemini) ko'rsatib: <em>"aynan shu formatda, [fan]dan N ta test savoli yoz"</em> deb so'rang</li>
        <li>AI natijasini <code>.txt</code> fayl sifatida saqlang</li>
        <li>Shu yerdan yuklang — tizim avval oldindan ko'rsatadi, siz tasdiqlagach saqlanadi</li>
    </ol>
</div>

<a asp-action="DownloadTemplate" class="btn btn-outline-primary mb-4">
    <i class="bi bi-download"></i> Shablonni yuklab olish
</a>

<form asp-action="Import" method="post" enctype="multipart/form-data" style="max-width: 480px;">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="form-group mb-3">
        <label asp-for="SubjectId" class="control-label"></label>
        <select asp-for="SubjectId" class="form-control" id="subjectSelect" asp-items="@(ViewBag.Subjects as SelectList)">
            <option value="">-- Fanni tanlang --</option>
        </select>
        <span asp-validation-for="SubjectId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="QuestionBankId" class="control-label"></label>
        <select asp-for="QuestionBankId" class="form-control" id="bankSelect">
            <option value="">-- Avval fanni tanlang --</option>
        </select>
        <span asp-validation-for="QuestionBankId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="File" class="control-label">To'ldirilgan .txt fayl</label>
        <input asp-for="File" type="file" accept=".txt" class="form-control" />
        <span asp-validation-for="File" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="bi bi-upload"></i> Yuklash va tekshirish
    </button>
    <a asp-action="Index" class="btn btn-secondary">Bekor qilish</a>
    <script>
            const subjectBanksMap = @Html.Raw(ViewBag.SubjectBanksJson ?? "{}");
            const subjectSelect = document.getElementById('subjectSelect');
            const bankSelect = document.getElementById('bankSelect');

            function refreshBanks() {
                const banks = subjectBanksMap[subjectSelect.value] || [];
                bankSelect.innerHTML = banks.length
                    ? '<option value="">-- Bankni tanlang --</option>'
                    : '<option value="">-- Bu fanda hali bank yo\'q --</option>';
                banks.forEach(function(b) {
                    const opt = document.createElement('option');
                    opt.value = b.id;
                    opt.textContent = b.name;
                    bankSelect.appendChild(opt);
                });
            }

            subjectSelect.addEventListener('change', refreshBanks);
            refreshBanks();
    </script>
</form>
