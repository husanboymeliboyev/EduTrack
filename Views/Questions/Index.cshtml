@model IEnumerable<EduTrack.Models.Question>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Savollar banki";
}

<h1>Savollar banki</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <form asp-action="Index" method="get" class="d-flex align-items-center">
        <label class="me-2 mb-0">Fan bo'yicha filtr:</label>
        <select name="subjectId" class="form-control" style="width:auto" onchange="this.form.submit()"
                asp-items="@(ViewBag.Subjects as SelectList)">
            <option value="">-- Barcha fanlar --</option>
        </select>
    </form>
    <a asp-action="Create" class="btn btn-primary">+ Yangi savol qo'shish</a>
    <a asp-action="Import" class="btn btn-outline-primary">
        <i class="bi bi-file-earmark-arrow-up"></i> AI orqali ommaviy import qilish
    </a>
</div>

@if (!Model.Any())
{
    <div class="iz-empty"><i class="bi bi-patch-question"></i><p>Hozircha savollar yo'q. Yuqoridagi tugma orqali qo'shishingiz mumkin.</p></div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead>
                <tr>
                    <th style="width: 35%">Savol</th>
                    <th>Rasm</th>
                    <th>Fan</th>
                    <th>Variantlar</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="question-latex">@item.Text</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img src="~/@item.ImagePath" alt="Savol rasmi" style="max-width: 80px; border-radius: 6px;" />
                            }
                        </td>
                        <td>@item.Subject?.Name</td>
                        <td>
                            <ul class="list-unstyled mb-0">
                                @foreach (var option in item.Options)
                                {
                                    <li>
                                        @if (option.IsCorrect)
                                        {
                                            <span class="text-success fw-bold question-latex">✓ @option.Text</span>
                                        }
                                        else
                                        {
                                            <span class="question-latex">@option.Text</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Tahrirlash</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">O'chirish</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
    <script>
        document.querySelectorAll('.question-latex').forEach(function(el) {
            renderMathInElement(el, {
                delimiters: [
                    { left: '$$', right: '$$', display: true },
                    { left: '$', right: '$', display: false }
                ]
            });
        });
    </script>
}