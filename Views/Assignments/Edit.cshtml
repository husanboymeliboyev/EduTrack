@model EduTrack.Models.Assignment
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Topshiriqni tahrirlash";
    bool hasSubmissions = ViewBag.HasSubmissions ?? false;
}

<div class="iz-page-head">
    <div>
        <a asp-action="Index" class="text-decoration-none small text-muted">
            <i class="bi bi-arrow-left"></i> Topshiriqlarga qaytish
        </a>
        <h1 class="mt-1">Topshiriqni tahrirlash</h1>
        <p class="iz-page-head__sub">Sarlavha, tavsif, guruh, muddat va biriktirilgan faylni yangilashingiz mumkin.</p>
    </div>
</div>
<div class="iz-signature-line"></div>

@if (hasSubmissions)
{
    <div class="alert alert-warning">
        <i class="bi bi-lock"></i>
        Bu topshiriqqa allaqachon talaba javoblari yuborilgan, shuning uchun <strong>Fan</strong>
        o'zgartirilmaydi. Sarlavha, Tavsif, Guruh, Muddat va faylni o'zgartirishingiz mumkin.
    </div>
}

<div class="card border-0">
    <div class="card-body p-3 p-md-4">
        <form asp-action="Edit" asp-route-id="@Model.Id" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Title" class="form-label">Sarlavha</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="DueDate" class="form-label">Topshirish muddati</label>
                    <input asp-for="DueDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="DueDate" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label">Tavsif</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Fan</label>
                    @if (hasSubmissions)
                    {
                        var subjectsList = ViewBag.Subjects as SelectList;
                        var subjectName = subjectsList?.FirstOrDefault(i => i.Value == Model.SubjectId.ToString())?.Text;
                        <input class="form-control" value="@subjectName" disabled />
                        <input type="hidden" asp-for="SubjectId" />
                        <div class="form-text">Talaba javoblari mavjud bo'lgani uchun fan qulflangan.</div>
                    }
                    else
                    {
                        <select asp-for="SubjectId" id="subjectSelect" class="form-select" asp-items="ViewBag.Subjects">
                            <option value="">-- Tanlang --</option>
                        </select>
                    }
                </div>

                <div class="col-md-6">
                    <label class="form-label">Guruh</label>
                    <select asp-for="GroupId" id="groupSelect" class="form-select">
                        <option value="">-- Barcha guruhlar --</option>
                    </select>
                    <div class="form-text">Bitta guruh uchun bo'lsa tanlang, aks holda fanga tegishli barcha guruhlarga ko'rinadi.</div>
                </div>

                <div class="col-12">
                    @if (!string.IsNullOrEmpty(Model.FilePath))
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="text-muted small">Mavjud fayl:</span>
                            <a class="iz-assign-file" href="~/@Model.FilePath" target="_blank" rel="noopener">
                                <i class="bi bi-paperclip"></i>@Model.FileName
                            </a>
                        </div>
                    }
                    <label class="form-label">
                        @(string.IsNullOrEmpty(Model.FilePath) ? "Fayl biriktirish (ixtiyoriy)" : "Faylni almashtirish (ixtiyoriy)")
                    </label>
                    <input type="file" name="file" class="form-control"
                           accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.png,.jpg,.jpeg,.zip,.rar" />
                    <div class="form-text">PDF, Word, PowerPoint, Excel, rasm yoki ZIP/RAR · 20 MB gacha.</div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Saqlash</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Bekor qilish</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const subjectGroups = @Html.Raw(ViewBag.SubjectGroupsJson ?? "[]");
        const hasSubmissions = @Html.Raw(hasSubmissions ? "true" : "false");
        const currentGroupId = "@Model.GroupId";
        const currentSubjectId = "@Model.SubjectId";

        const subjectSelect = document.getElementById('subjectSelect'); // null bo'lishi mumkin (hasSubmissions=true bo'lsa)
        const groupSelect = document.getElementById('groupSelect');

        function refreshGroups() {
            const subjectId = parseInt(subjectSelect ? subjectSelect.value : currentSubjectId);
            groupSelect.innerHTML = '<option value="">-- Barcha guruhlar --</option>';
            subjectGroups
                .filter(function(sg) { return sg.SubjectId === subjectId; })
                .forEach(function(sg) {
                    const opt = document.createElement('option');
                    opt.value = sg.GroupId;
                    opt.textContent = sg.GroupName;
                    if (String(sg.GroupId) === currentGroupId) opt.selected = true;
                    groupSelect.appendChild(opt);
                });
        }

        if (subjectSelect) {
            subjectSelect.addEventListener('change', refreshGroups);
        }
        refreshGroups();
    </script>
}
