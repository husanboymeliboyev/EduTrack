@model IEnumerable<EduTrack.Models.Assignment>

@{
    ViewData["Title"] = "Topshiriqlar";
}

<h1>Mening topshiriqlarim</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">+ Yangi topshiriq</a>
</p>

@if (!Model.Any())
{
    <p class="text-muted">Hozircha topshiriqlar yo'q.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Sarlavha</th>
                <th>Fan</th>
                <th>Muddat</th>
                <th>Topshirilgan</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var isOverdue = item.DueDate < DateTime.Now;
                <tr>
                    <td>
                        @item.Title
                        @if (!string.IsNullOrEmpty(item.FilePath))
                        {
                            <br /><a href="~/@item.FilePath" target="_blank" class="small">📎 @item.FileName</a>
                        }
                    </td>
                    <td>@item.Subject?.Name</td>
                    <td>
                        @item.DueDate.ToString("dd.MM.yyyy HH:mm")
                        @if (isOverdue)
                        {
                            <span class="badge bg-danger ms-1">Muddati o'tgan</span>
                        }
                    </td>
                    <td>@item.Submissions.Count</td>
                    <td>
                        <a asp-action="Submissions" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Ko'rish</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}