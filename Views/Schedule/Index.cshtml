@model EduTrack.ViewModels.WeeklyScheduleViewModel
@{
    ViewData["Title"] = "Dars jadvali";
    var canManage = User.IsInRole("Admin");
    ViewData["AllowManage"] = canManage;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">@Model.Title</h3>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary">+ Yangi dars qo'shish</a>
    }
    else
    {
        <span class="badge" style="background-color: var(--iz-info-bg); color: var(--iz-info-text);">
            <i class="bi bi-eye"></i> Faqat ko'rish
        </span>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@await Html.PartialAsync("_WeeklyGrid", Model.Blocks)