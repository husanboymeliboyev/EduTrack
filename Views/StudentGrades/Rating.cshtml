@model List<EduTrack.ViewModels.GroupRankingEntryViewModel>
@{
    ViewData["Title"] = "Guruh reytingi";
    var myStudentId = ViewBag.MyStudentId as string;
}

<div class="iz-page-head">
    <div>
        <h1 class="mb-1">Guruh ichida reyting</h1>
        <p class="text-muted mb-0">Fan baholari bo'yicha o'rtacha natija asosida</p>
    </div>
    <span class="iz-grade-pill"><i class="bi bi-trophy"></i> 100 ballik shkala</span>
</div>
<div class="iz-signature-line"></div>

@if (!Model.Any())
{
    <div class="iz-empty mt-4">
        <i class="bi bi-bar-chart"></i>
        <p>Hozircha reyting uchun ma'lumot yo'q.</p>
    </div>
}
else
{
    <div class="iz-grade-table-wrap">
        <table class="table iz-grade-table align-middle mb-0">
            <thead>
                <tr>
                    <th style="width:80px;">#</th>
                    <th>O'quvchi</th>
                    <th class="text-end" style="width:180px;">O'rtacha ball</th>
                    <th class="text-end" style="width:150px;">Daraja</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model)
                {
                    var isMe = entry.StudentId == myStudentId;
                    var medal = entry.Rank switch
                    {
                        1 => "iz-rank-medal is-gold",
                        2 => "iz-rank-medal is-silver",
                        3 => "iz-rank-medal is-bronze",
                        _ => "iz-rank-medal"
                    };

                    <tr class="@(isMe ? "is-me" : "")">
                        <td>
                            <span class="@medal">@entry.Rank</span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="iz-grade-avatar">@(string.IsNullOrWhiteSpace(entry.StudentName) ? "?" : entry.StudentName.Trim().Substring(0, 1).ToUpperInvariant())</span>
                                <span class="fw-semibold">@entry.StudentName</span>
                                @if (isMe)
                                {
                                    <span class="badge rounded-pill iz-me-badge">Siz</span>
                                }
                            </div>
                        </td>
                        <td class="text-end fw-bold">@entry.AveragePercentage.ToString("0.#")</td>
                        <td class="text-end">
                            <span class="iz-grade-tone @(entry.AveragePercentage >= 86 ? "is-excellent" : entry.AveragePercentage >= 71 ? "is-good" : entry.AveragePercentage >= 55 ? "is-fair" : "is-low")">
                                @(entry.AveragePercentage >= 86 ? "A'lo" : entry.AveragePercentage >= 71 ? "Yaxshi" : entry.AveragePercentage >= 55 ? "Qoniqarli" : "Qoniqarsiz")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
