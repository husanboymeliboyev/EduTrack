@model EduTrack.ViewModels.AdminAttendanceDailyViewModel
@{
    ViewData["Title"] = "Kunlik davomat";
    var dateValue = Model.Date.ToString("yyyy-MM-dd");
    var maxDateValue = Clock.Today.ToString("yyyy-MM-dd");
    var monthValue = Model.Date.ToString("yyyy-MM");
}

@functions {
    static string PercentBadgeClass(int percentage) => percentage switch
    {
        >= 85 => "text-bg-success",
        >= 60 => "text-bg-warning",
        _ => "text-bg-danger"
    };
}

<div class="iz-page-head mb-3">
    <div>
        <h1><i class="bi bi-calendar-day"></i> Kunlik davomat</h1>
        <p class="iz-page-head__sub">
            @Model.DateLabel — qaysi guruh/fan darsida kim kelmagan va kim
            belgilanmagan. Faqat ko'rish uchun.
        </p>
    </div>
    <div class="iz-page-head__actions">
        <a class="btn btn-outline-secondary btn-sm"
           asp-action="Index"
           asp-route-subjectId="@Model.SubjectId"
           asp-route-groupId="@Model.GroupId"
           asp-route-month="@monthValue">
            <i class="bi bi-calendar3"></i> Oylik ko'rinish
        </a>
    </div>
</div>

<form method="get" asp-action="Daily" class="iz-journal-toolbar">
    <div class="iz-journal-filter">
        <label for="dailyDate">Sana</label>
        <input id="dailyDate"
               type="date"
               name="date"
               class="form-control"
               value="@dateValue"
               max="@maxDateValue"
               onchange="this.form.submit()" />
    </div>

    <div class="iz-journal-filter">
        <label for="dailySubject">Fan</label>
        <select id="dailySubject" name="subjectId" class="form-select" onchange="this.form.submit()">
            <option value="">Barcha fanlar</option>
            @foreach (var subject in Model.Subjects)
            {
                <option value="@subject.Id" selected="@(Model.SubjectId == subject.Id ? "selected" : null)">
                    @subject.Name
                </option>
            }
        </select>
    </div>

    <div class="iz-journal-filter">
        <label for="dailyGroup">Guruh</label>
        <select id="dailyGroup" name="groupId" class="form-select" onchange="this.form.submit()">
            <option value="">Barcha guruhlar</option>
            @foreach (var group in Model.Groups)
            {
                <option value="@group.Id" selected="@(Model.GroupId == group.Id ? "selected" : null)">
                    @group.Name
                </option>
            }
        </select>
    </div>

    <div class="iz-journal-nav" role="group" aria-label="Kun navigatsiyasi">
        <a class="iz-journal-nav-btn"
           asp-action="Daily"
           asp-route-date="@Model.PreviousDate.ToString("yyyy-MM-dd")"
           asp-route-subjectId="@Model.SubjectId"
           asp-route-groupId="@Model.GroupId"
           aria-label="Oldingi kun">
            <i class="bi bi-chevron-left"></i>
        </a>
        <a class="iz-journal-nav-btn"
           asp-action="Daily"
           asp-route-subjectId="@Model.SubjectId"
           asp-route-groupId="@Model.GroupId"
           asp-route-date="@maxDateValue">
            Bugun
        </a>
        @if (Model.CanGoNext)
        {
            <a class="iz-journal-nav-btn"
               asp-action="Daily"
               asp-route-date="@Model.NextDate.ToString("yyyy-MM-dd")"
               asp-route-subjectId="@Model.SubjectId"
               asp-route-groupId="@Model.GroupId"
               aria-label="Keyingi kun">
                <i class="bi bi-chevron-right"></i>
            </a>
        }
        else
        {
            <span class="iz-journal-nav-btn is-disabled" aria-disabled="true">
                <i class="bi bi-chevron-right"></i>
            </span>
        }
    </div>

    <button type="submit" class="btn btn-primary">Ko'rsatish</button>
</form>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-4 col-xl">
        <div class="iz-kpi">
            <span class="iz-kpi__icon is-blue"><i class="bi bi-journal-text"></i></span>
            <div class="iz-kpi__body">
                <span class="iz-kpi__label">Darslar</span>
                <span class="iz-kpi__value">@Model.PairCount</span>
                <span class="iz-kpi__meta">Jadval + shu kundagi yozuvlar</span>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="iz-kpi">
            <span class="iz-kpi__icon is-violet"><i class="bi bi-mortarboard"></i></span>
            <div class="iz-kpi__body">
                <span class="iz-kpi__label">Kutilgan o'quvchilar</span>
                <span class="iz-kpi__value">@Model.ExpectedCount</span>
                <span class="iz-kpi__meta">Takrorlanmas: @Model.StudentCount</span>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="iz-kpi">
            <span class="iz-kpi__icon is-green"><i class="bi bi-check2-circle"></i></span>
            <div class="iz-kpi__body">
                <span class="iz-kpi__label">Davomat</span>
                <span class="iz-kpi__value">@Model.Percentage%</span>
                <span class="iz-kpi__meta">Keldi: @Model.Keldi · Belgilangan: @Model.Total</span>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="iz-kpi">
            <span class="iz-kpi__icon is-rose"><i class="bi bi-x-circle"></i></span>
            <div class="iz-kpi__body">
                <span class="iz-kpi__label">Kelmadi</span>
                <span class="iz-kpi__value">@Model.Kelmadi</span>
                <span class="iz-kpi__meta">Kech: @Model.KechQoldi · Sababli: @Model.Sababli</span>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="iz-kpi">
            <span class="iz-kpi__icon is-amber"><i class="bi bi-question-circle"></i></span>
            <div class="iz-kpi__body">
                <span class="iz-kpi__label">Belgilanmagan</span>
                <span class="iz-kpi__value">@Model.Unmarked</span>
                <span class="iz-kpi__meta">Davomat hali qo'yilmagan</span>
            </div>
        </div>
    </div>
</div>

@if (Model.Pairs.Count == 0)
{
    <div class="iz-empty">
        <i class="bi bi-calendar-x"></i>
        <p>Bu kunda dars jadvali ham, davomat yozuvi ham topilmadi.</p>
    </div>
    return;
}

<div class="card shadow-sm border-0 rounded-4">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Fan</th>
                    <th>Guruh</th>
                    <th>O'qituvchi</th>
                    <th class="text-center">O'quvchilar</th>
                    <th class="text-center">Keldi</th>
                    <th class="text-center">Kelmadi</th>
                    <th class="text-center">Kech</th>
                    <th class="text-center">Sababli</th>
                    <th class="text-center">Belgilanmagan</th>
                    <th class="text-center">Davomat</th>
                    <th>Kelmaganlar</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Pairs)
                {
                    <tr>
                        <td class="fw-semibold">
                            @row.SubjectName
                            @if (!row.HasSchedule)
                            {
                                <span class="badge text-bg-light ms-1" title="Dars jadvalida yo'q, lekin davomat yozuvi bor">
                                    qo'shimcha
                                </span>
                            }
                        </td>
                        <td>@row.GroupName</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(row.TeacherName))
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                @row.TeacherName
                            }
                        </td>
                        <td class="text-center">@row.StudentCount</td>
                        <td class="text-center text-success fw-semibold">@row.Keldi</td>
                        <td class="text-center text-danger fw-semibold">@row.Kelmadi</td>
                        <td class="text-center">@row.KechQoldi</td>
                        <td class="text-center">@row.Sababli</td>
                        <td class="text-center">
                            @if (row.Unmarked > 0)
                            {
                                <span class="badge text-bg-secondary"
                                      title="@string.Join(", ", row.UnmarkedStudents.Select(s => s.FullName))">
                                    @row.Unmarked
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (row.Total == 0)
                            {
                                <span class="badge text-bg-secondary">—</span>
                            }
                            else
                            {
                                <span class="badge @PercentBadgeClass(row.Percentage)">@row.Percentage%</span>
                            }
                        </td>
                        <td>
                            @if (row.AbsentStudents.Count == 0)
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <span class="small text-danger">
                                    @string.Join(", ", row.AbsentStudents.Take(4).Select(s => s.FullName))
                                </span>
                                @if (row.AbsentStudents.Count > 4)
                                {
                                    <span class="small text-muted">+@(row.AbsentStudents.Count - 4)</span>
                                }
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-action="Detail"
                               asp-route-subjectId="@row.SubjectId"
                               asp-route-groupId="@row.GroupId"
                               asp-route-month="@monthValue">
                                <i class="bi bi-table"></i> Oy bo'yicha
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
