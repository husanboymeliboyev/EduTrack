@using System.Globalization
@using EduTrack.ViewModels
@model EduTrack.ViewModels.AdminExamListPageViewModel

@{
    ViewData["Title"] = "Imtihon natijalari";
    var approvedOnly = ViewBag.ApprovedOnly as bool? ?? false;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="mb-1">Imtihon natijalari</h1>
        <p class="text-muted mb-0">
            @if (approvedOnly)
            {
                @("Faqat o'qituvchi tasdiqlagan natijalar — ko'rish va Excel eksport.")
            }
            else
            {
                @("Barcha o'qituvchilarning imtihonlari — faqat ko'rish va Excel eksport.")
            }
        </p>
    </div>
</div>

@if (approvedOnly)
{
    <div class="alert alert-info d-flex align-items-start gap-2 py-2">
        <i class="bi bi-shield-check"></i>
        <div class="small">
            Moderator rejimi: tasdiqlanmagan natijalar va imtihon savollari ko'rsatilmaydi.
        </div>
    </div>
}

<form method="get" asp-action="Index" class="card card-body mb-3">
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label" for="Search">Qidiruv</label>
            <input class="form-control"
                   id="Search"
                   name="Search"
                   value="@Model.Filter.Search"
                   placeholder="Imtihon, fan yoki o'qituvchi" />
        </div>

        <div class="col-md-2">
            <label class="form-label" for="SubjectId">Fan</label>
            <select class="form-select" id="SubjectId" name="SubjectId">
                <option value="">Barchasi</option>
                @foreach (var subject in Model.Subjects)
                {
                    <option value="@subject.Id"
                            selected="@(Model.Filter.SubjectId == subject.Id ? "selected" : null)">
                        @subject.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label" for="TeacherId">O'qituvchi</label>
            <select class="form-select" id="TeacherId" name="TeacherId">
                <option value="">Barchasi</option>
                @foreach (var teacher in Model.Teachers)
                {
                    <option value="@teacher.Id"
                            selected="@(Model.Filter.TeacherId == teacher.Id ? "selected" : null)">
                        @teacher.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label" for="GroupId">Guruh</label>
            <select class="form-select" id="GroupId" name="GroupId">
                <option value="">Barchasi</option>
                @foreach (var group in Model.Groups)
                {
                    <option value="@group.Id"
                            selected="@(Model.Filter.GroupId == group.Id ? "selected" : null)">
                        @group.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-1">
            <label class="form-label" for="Status">Holat</label>
            <select class="form-select" id="Status" name="Status">
                <option value="">Barchasi</option>
                <option value="@AdminExamListStatus.Active"
                        selected="@(Model.Filter.Status == AdminExamListStatus.Active ? "selected" : null)">
                    Faol
                </option>
                <option value="@AdminExamListStatus.Archived"
                        selected="@(Model.Filter.Status == AdminExamListStatus.Archived ? "selected" : null)">
                    Arxiv
                </option>
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label" for="PageSize">Sahifa hajmi</label>
            <select class="form-select" id="PageSize" name="PageSize">
                @foreach (var size in AdminExamListFilterViewModel.AllowedPageSizes)
                {
                    <option value="@size"
                            selected="@(Model.Filter.PageSize == size ? "selected" : null)">
                        @size
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label" for="Sort">Tartiblash</label>
            <select class="form-select" id="Sort" name="Sort">
                <option value="@AdminExamListSort.DateDesc"
                        selected="@(Model.Filter.Sort == AdminExamListSort.DateDesc ? "selected" : null)">
                    Sana (yangi → eski)
                </option>
                <option value="@AdminExamListSort.DateAsc"
                        selected="@(Model.Filter.Sort == AdminExamListSort.DateAsc ? "selected" : null)">
                    Sana (eski → yangi)
                </option>
                <option value="@AdminExamListSort.TitleAsc"
                        selected="@(Model.Filter.Sort == AdminExamListSort.TitleAsc ? "selected" : null)">
                    Imtihon nomi (A → Z)
                </option>
                <option value="@AdminExamListSort.TitleDesc"
                        selected="@(Model.Filter.Sort == AdminExamListSort.TitleDesc ? "selected" : null)">
                    Imtihon nomi (Z → A)
                </option>
                <option value="@AdminExamListSort.ResultsDesc"
                        selected="@(Model.Filter.Sort == AdminExamListSort.ResultsDesc ? "selected" : null)">
                    Natijalar soni (ko'p → kam)
                </option>
            </select>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mt-3">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-funnel"></i> Filtrlash
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            Tozalash
        </a>
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <div class="iz-empty">
        <i class="bi bi-clipboard-data"></i>
        <p>
            @(Model.Filter.HasActiveFilters
                ? "Filtrga mos imtihon topilmadi."
                : "Hozircha imtihon yo'q.")
        </p>
    </div>

    @if (Model.Filter.HasActiveFilters)
    {
        <div class="text-center mt-2">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                Filtrlarni tozalash
            </a>
        </div>
    }
}
else
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <span class="text-muted">@Model.TotalCount ta imtihon</span>
        <span class="text-muted ms-auto">Sahifa @Model.Page / @Model.TotalPages</span>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead>
                <tr>
                    <th>Imtihon</th>
                    <th>Fan</th>
                    <th>O'qituvchi</th>
                    <th>Guruh</th>
                    <th>Savollar</th>
                    <th>Natijalar</th>
                    <th>Yaratilgan</th>
                    <th>Holat</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var exam in Model.Rows)
                {
                    <tr>
                        <td>@exam.Title</td>
                        <td>@(exam.SubjectName ?? "-")</td>
                        <td>@(exam.TeacherName ?? "-")</td>
                        <td>@(exam.GroupName ?? "Barcha guruhlar")</td>
                        <td>@exam.QuestionCount</td>
                        <td>@exam.ResultsCount</td>
                        <td>@exam.CreatedDate.ToString("dd.MM.yyyy HH:mm", CultureInfo.InvariantCulture)</td>
                        <td>
                            @if (exam.IsArchived)
                            {
                                <span class="badge" style="background-color: var(--iz-info-bg); color: var(--iz-info-text);">
                                    <i class="bi bi-archive"></i> Arxivlangan
                                </span>
                            }
                            else
                            {
                                <span class="badge" style="background-color: var(--iz-success-bg); color: var(--iz-success-text);">
                                    <i class="bi bi-check-circle"></i> Faol
                                </span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <a asp-action="Results"
                               asp-route-id="@exam.Id"
                               class="btn btn-sm btn-info">
                                <i class="bi bi-bar-chart"></i> Natijalar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        var start = Math.Max(1, Model.Page - 2);
        var end = Math.Min(Model.TotalPages, start + 4);
        start = Math.Max(1, end - 4);

        <nav class="mt-3" aria-label="Imtihonlar sahifalari">
            <ul class="pagination mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : string.Empty)">
                    <a class="page-link"
                       asp-action="Index"
                       asp-all-route-data="@Model.ToRouteValues(Model.Page - 1)">
                        Oldingi
                    </a>
                </li>

                @if (start > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-all-route-data="@Model.ToRouteValues(1)">1</a>
                    </li>
                    @if (start > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }

                @for (var p = start; p <= end; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : string.Empty)">
                        <a class="page-link"
                           asp-action="Index"
                           asp-all-route-data="@Model.ToRouteValues(p)">@p</a>
                    </li>
                }

                @if (end < Model.TotalPages)
                {
                    @if (end < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-all-route-data="@Model.ToRouteValues(Model.TotalPages)">@Model.TotalPages</a>
                    </li>
                }

                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : string.Empty)">
                    <a class="page-link"
                       asp-action="Index"
                       asp-all-route-data="@Model.ToRouteValues(Model.Page + 1)">
                        Keyingi
                    </a>
                </li>
            </ul>
        </nav>
    }
}
