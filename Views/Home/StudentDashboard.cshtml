@model EduTrack.Models.Group?
@{
    ViewData["Title"] = "Mening kabinetim";
    var stats = ViewBag.AttendanceStats as List<EduTrack.ViewModels.StudentAttendanceStatsViewModel>;
}

<h1>Xush kelibsiz, @ViewBag.DisplayName!</h1>
<div class="iz-signature-line"></div>

@if (Model == null)
{
    <p class="text-muted mt-4">Siz hali hech qanday guruhga biriktirilmagansiz. Administrator bilan bog'laning.</p>
}
else
{
    <h3 class="mt-4">Guruhingiz: @Model.Name</h3>
}

<h3 class="mt-4">Davomat statistikasi</h3>

@if (stats == null || !stats.Any())
{
    <div class="iz-empty"><i class="bi bi-calendar-check"></i><p>Hozircha davomat ma'lumotlari yo'q.</p></div>
}
else
{
    <div class="table-responsive">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Fan</th>
                <th>Jami darslar</th>
                <th>Qatnashgan</th>
                <th>Foiz</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var stat in stats)
            {
                var barClass = stat.Percentage >= 80 ? "bg-success" : stat.Percentage >= 60 ? "bg-warning" : "bg-danger";
                <tr>
                    <td>@stat.SubjectName</td>
                    <td>@stat.TotalLessons</td>
                    <td>@stat.PresentCount</td>
                    <td>
                        <div class="progress" style="height: 20px;">
                            <div class="progress-bar @barClass" style="width: @stat.Percentage%">
                                @stat.Percentage%
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
        @{
            var attendanceLabels = stats?.Select(s => s.SubjectName).ToList();
            var attendancePercents = stats?.Select(s => s.Percentage).ToList();
            var examLabels = ViewBag.ExamResultLabels as List<string>;
        }

        <div class="row mt-4">
            @if (attendanceLabels != null && attendanceLabels.Any())
            {
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Davomat foizi (fanlar bo'yicha)</h5>
                            <canvas id="attendanceChart" style="max-height: 300px;"></canvas>
                        </div>
                    </div>
                </div>
            }
            @if (examLabels != null && examLabels.Any())
            {
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Imtihon natijalari (%)</h5>
                            <canvas id="examResultChart" style="max-height: 300px;"></canvas>
                        </div>
                    </div>
                </div>
            }
        </div>

        @section Scripts {
            @if ((attendanceLabels != null && attendanceLabels.Any()) || (examLabels != null && examLabels.Any()))
            {
                <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
            }
            @if (attendanceLabels != null && attendanceLabels.Any())
            {
                <script>
                        new Chart(document.getElementById('attendanceChart'), {
                            type: 'bar',
                            data: {
                                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(attendanceLabels)),
                                datasets: [{
                                    label: 'Davomat %',
                                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(attendancePercents)),
                                    backgroundColor: '#198754'
                                }]
                            },
                            options: {
                                responsive: true,
                                scales: { y: { beginAtZero: true, max: 100 } },
                                plugins: { legend: { display: false } }
                            }
                        });
                </script>
            }
            @if (examLabels != null && examLabels.Any())
            {
                <script>
                        new Chart(document.getElementById('examResultChart'), {
                            type: 'bar',
                            data: {
                                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(examLabels)),
                                datasets: [{
                                    label: 'Natija %',
                                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ExamResultPercents)),
                                    backgroundColor: '#0d6efd'
                                }]
                            },
                            options: {
                                responsive: true,
                                scales: { y: { beginAtZero: true, max: 100 } },
                                plugins: { legend: { display: false } }
                            }
                        });
                </script>
            }
        }
    </table>
    </div>
}