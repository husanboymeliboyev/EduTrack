@{
    ViewData["Title"] = "Boshqaruv paneli";
}

<h1>Xush kelibsiz, @ViewBag.DisplayName!</h1>
<div class="iz-signature-line"></div>

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Foydalanuvchilar</h5>
                <p class="card-text display-6">@ViewBag.TotalUsers</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Guruhlar</h5>
                <p class="card-text display-6">@ViewBag.TotalGroups</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title">Fanlar</h5>
                <p class="card-text display-6">@ViewBag.TotalSubjects</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info mb-3">
            <div class="card-body">
                <h5 class="card-title">Talabalar</h5>
                <p class="card-text display-6">@ViewBag.TotalStudents</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Groups" asp-action="Index" class="btn btn-outline-primary">Guruhlarni boshqarish</a>
    <a asp-controller="Subjects" asp-action="Index" class="btn btn-outline-success">Fanlarni boshqarish</a>
    <a asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary">Foydalanuvchilarni boshqarish</a>
</div>
<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Foydalanuvchilar taqsimoti</h5>
                <canvas id="roleChart" style="max-height: 300px;"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const roleLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.RoleLabels));
        const roleCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.RoleCounts));

        new Chart(document.getElementById('roleChart'), {
            type: 'pie',
            data: {
                labels: roleLabels,
                datasets: [{
                    data: roleCounts,
                    backgroundColor: ['#0d6efd', '#198754', '#0dcaf0']
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });
    </script>
}