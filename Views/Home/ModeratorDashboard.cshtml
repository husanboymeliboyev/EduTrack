@{
    ViewData["Title"] = "Moderator paneli";
}

<h1>Xush kelibsiz, @ViewBag.DisplayName!</h1>
<div class="iz-signature-line"></div>

<div class="alert alert-info d-flex align-items-start gap-2 mt-3">
    <i class="bi bi-shield-check fs-5"></i>
    <div>
        <strong>Moderator (zauch) paneli.</strong>
        Tahlil, imtihon savollari va tasdiqlanmagan natijalar bu panelda ko'rinmaydi.
        Faqat o'qituvchi tasdiqlagan imtihon natijalari ochiq.
    </div>
</div>

<div class="row g-3 mt-3 mb-1">
    <div class="col-6 col-md-3">
        <div class="iz-kpi">
            <span class="iz-kpi__icon is-green"><i class="bi bi-mortarboard"></i></span>
            <div class="iz-kpi__body">
                <span class="iz-kpi__label">O'quvchilar</span>
                <span class="iz-kpi__value">@ViewBag.StudentCount</span>
                <span class="iz-kpi__meta">Tizimdagi barcha o'quvchilar</span>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="iz-kpi">
            <span class="iz-kpi__icon is-blue"><i class="bi bi-people"></i></span>
            <div class="iz-kpi__body">
                <span class="iz-kpi__label">Guruhlar</span>
                <span class="iz-kpi__value">@ViewBag.ClassGroupCount</span>
                <span class="iz-kpi__meta">
                    Sinf · @ViewBag.StreamGroupCount yo'nalish@((int)ViewBag.ArchivedGroupCount > 0 ? $" · {ViewBag.ArchivedGroupCount} arxiv" : "")
                </span>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="iz-kpi">
            <span class="iz-kpi__icon is-amber"><i class="bi bi-journal-bookmark"></i></span>
            <div class="iz-kpi__body">
                <span class="iz-kpi__label">Fanlar</span>
                <span class="iz-kpi__value">@ViewBag.TotalSubjects</span>
                <span class="iz-kpi__meta">O'quv dasturidagi fanlar</span>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="iz-kpi">
            <span class="iz-kpi__icon is-violet"><i class="bi bi-clipboard-check"></i></span>
            <div class="iz-kpi__body">
                <span class="iz-kpi__label">Tasdiqlangan natijalar</span>
                <span class="iz-kpi__value">@ViewBag.ApprovedExamResultCount</span>
                <span class="iz-kpi__meta">@ViewBag.ApprovedExamCount imtihon bo'yicha</span>
            </div>
        </div>
    </div>
</div>

<h6 class="text-muted text-uppercase mt-4 mb-2" style="letter-spacing:.05em;">Tezkor amallar</h6>
<div class="row g-3">
    <div class="col-sm-6 col-lg-3">
        <a asp-controller="Groups" asp-action="Index" class="iz-quick">
            <span class="iz-quick__icon is-green"><i class="bi bi-people"></i></span>
            <span class="iz-quick__text">Guruhlar<span>Sinflar va yo'nalishlar</span></span>
            <i class="bi bi-arrow-right iz-quick__arrow"></i>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a asp-controller="Subjects" asp-action="Index" class="iz-quick">
            <span class="iz-quick__icon is-amber"><i class="bi bi-journal-bookmark"></i></span>
            <span class="iz-quick__text">Fanlar<span>Faqat ko'rish</span></span>
            <i class="bi bi-arrow-right iz-quick__arrow"></i>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a asp-controller="Users" asp-action="Index" class="iz-quick">
            <span class="iz-quick__icon is-blue"><i class="bi bi-person-badge"></i></span>
            <span class="iz-quick__text">Foydalanuvchilar<span>O'quvchi va o'qituvchilar</span></span>
            <i class="bi bi-arrow-right iz-quick__arrow"></i>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a asp-controller="Schedule" asp-action="Index" class="iz-quick">
            <span class="iz-quick__icon is-violet"><i class="bi bi-calendar-week"></i></span>
            <span class="iz-quick__text">Dars jadvali<span>Haftalik jadval</span></span>
            <i class="bi bi-arrow-right iz-quick__arrow"></i>
        </a>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body">
                <h6 class="text-muted text-uppercase" style="letter-spacing:.05em;">Tizim holati</h6>
                <div class="table-responsive">
                    <table class="table table-borderless align-middle mb-0">
                        <tbody>
                            <tr>
                                <td class="text-muted"><i class="bi bi-person me-2"></i>Jami foydalanuvchilar</td>
                                <td class="text-end fw-bold">@ViewBag.TotalUsers</td>
                            </tr>
                            <tr>
                                <td class="text-muted"><i class="bi bi-people me-2"></i>Guruhlar (sinf + yo'nalish)</td>
                                <td class="text-end fw-bold">@(ViewBag.ClassGroupCount + ViewBag.StreamGroupCount)</td>
                            </tr>
                            <tr>
                                <td class="text-muted"><i class="bi bi-journal-bookmark me-2"></i>Fanlar</td>
                                <td class="text-end fw-bold">@ViewBag.TotalSubjects</td>
                            </tr>
                            <tr>
                                <td class="text-muted"><i class="bi bi-clipboard-check me-2"></i>Tasdiqlangan imtihon natijalari</td>
                                <td class="text-end">
                                    <span class="badge bg-success-subtle text-success-emphasis">@ViewBag.ApprovedExamResultCount</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <a class="btn btn-sm btn-outline-primary mt-3" asp-controller="AdminExamResults" asp-action="Index">
                    <i class="bi bi-clipboard-check"></i> Tasdiqlangan natijalarni ko'rish
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body">
                <h6 class="text-muted text-uppercase" style="letter-spacing:.05em;">Cheklovlar</h6>
                <ul class="mb-0 ps-3 small text-muted">
                    <li>Analitika va imtihon savollari ko'rinmaydi.</li>
                    <li>Faqat tasdiqlangan imtihon natijalari ochiq.</li>
                    <li>Admin va moderator hisoblarini tahrirlash mumkin emas.</li>
                    <li>Parol tiklash va foydalanuvchini o'chirish faqat admin uchun.</li>
                    <li>Fanlar, jadval va guruh o'chirish faqat admin uchun.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
