@model IEnumerable<EduTrack.Models.Subject>
@using EduTrack.ViewModels

@{
    ViewData["Title"] = "Mening fanlarim";
    var stats = ViewBag.AttendanceStats as List<StudentAttendanceStatsViewModel>;
    var weeklyTrend = ViewBag.WeeklyTrend as List<WeeklyAttendanceTrendViewModel>;
    var overallPct = ViewBag.OverallAttendancePercentage != null ? (double)ViewBag.OverallAttendancePercentage : 0;
    var examLabels = ViewBag.ExamLabels as List<string>;
    var riskySubjects = stats?.Where(s => s.Percentage < 75).ToList();
}

<h1>Xush kelibsiz, @ViewBag.DisplayName!</h1>
<div class="iz-signature-line"></div>

<div class="row mt-4 g-3">
    <div class="col-md-4">
        <div class="iz-kpi">
            <span class="iz-kpi__icon is-green"><i class="bi bi-journal-bookmark"></i></span>
            <div class="iz-kpi__body">
                <span class="iz-kpi__label">Fanlarim</span>
                <span class="iz-kpi__value">@Model.Count()</span>
                <span class="iz-kpi__meta">Sizga biriktirilgan fanlar</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="iz-kpi">
            <span class="iz-kpi__icon is-blue"><i class="bi bi-collection"></i></span>
            <div class="iz-kpi__body">
                <span class="iz-kpi__label">Savollar banki</span>
                <span class="iz-kpi__value">@ViewBag.QuestionCount</span>
                <span class="iz-kpi__meta">Tayyor savollar soni</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="iz-kpi">
            <span class="iz-kpi__icon is-violet"><i class="bi bi-clipboard-data"></i></span>
            <div class="iz-kpi__body">
                <span class="iz-kpi__label">Imtihonlar</span>
                <span class="iz-kpi__value">@ViewBag.ExamCount</span>
                <span class="iz-kpi__meta">Yaratilgan imtihonlar</span>
            </div>
        </div>
    </div>
</div>

@if (Model.Any())
{
    <div class="mt-3 d-flex flex-wrap gap-2 align-items-center">
        <span class="text-muted small">Fanlar:</span>
        @foreach (var subject in Model)
        {
            <span class="badge rounded-pill text-bg-light border">@subject.Name</span>
        }
    </div>
}
else
{
    <p class="text-muted mt-3 mb-0">Sizga hali hech qanday fan biriktirilmagan. Administrator bilan bog'laning.</p>
}

<h3 class="mt-4">Davomat statistikasi</h3>

@if (stats == null || !stats.Any())
{
    <div class="iz-empty"><i class="bi bi-calendar-check"></i><p>Hozircha davomat ma'lumotlari yo'q.</p></div>
}
else
{
    @if (riskySubjects != null && riskySubjects.Any())
    {
        <div class="alert alert-danger d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>
                <strong>Diqqat:</strong>
                @string.Join(", ", riskySubjects.Select(s => $"{s.SubjectName} ({s.Percentage}%)"))
                fanlarida davomat 75% dan past.
            </div>
        </div>
    }

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body text-center">
                    <h6 class="card-title text-muted">Umumiy davomat</h6>
                    <canvas id="overallDonutChart" style="max-height: 200px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body">
                    <h6 class="card-title text-muted">Haftalik davomat trendi (oxirgi 8 hafta)</h6>
                    @if (weeklyTrend != null && weeklyTrend.Any())
                    {
                        <canvas id="weeklyTrendChart" style="max-height: 220px;"></canvas>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Trend uchun yetarli ma'lumot yo'q.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 mt-3">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-borderless align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Fan</th>
                            <th>Jami darslar</th>
                            <th>Kelgan</th>
                            <th>Foiz</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stat in stats)
                        {
                            var badgeClass = stat.Percentage >= 80 ? "bg-success" : stat.Percentage >= 60 ? "bg-warning text-dark" : "bg-danger";
                            <tr class="@(stat.Percentage < 75 ? "table-danger" : "")">
                                <td>
                                    @if (stat.Percentage < 75)
                                    {
                                        <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>
                                    }
                                    @stat.SubjectName
                                </td>
                                <td>@stat.TotalLessons</td>
                                <td>@stat.PresentCount</td>
                                <td><span class="badge @badgeClass">@stat.Percentage%</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (examLabels != null && examLabels.Any())
{
    <div class="row mt-4">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <h5 class="card-title">Imtihonlar bo'yicha o'rtacha ball (%)</h5>
                    <canvas id="examChart" style="max-height: 320px;"></canvas>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if ((weeklyTrend != null && weeklyTrend.Any()) || (stats != null && stats.Any()) || (examLabels != null && examLabels.Any()))
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

        <script>
            Chart.defaults.font.family = "'Inter', sans-serif";
            Chart.defaults.color = '#5A6663';

            const overallPercentage = @Html.Raw(overallPct.ToString(System.Globalization.CultureInfo.InvariantCulture));

            const centerTextPlugin = {
                id: 'centerText',
                afterDraw(chart) {
                    const { ctx, chartArea } = chart;
                    const x = (chartArea.left + chartArea.right) / 2;
                    const y = (chartArea.top + chartArea.bottom) / 2;
                    ctx.save();
                    ctx.font = 'bold 26px Manrope, sans-serif';
                    ctx.fillStyle = '#1C2321';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.fillText(overallPercentage + '%', x, y);
                    ctx.restore();
                }
            };
        </script>

        @if (stats != null && stats.Any())
        {
            <script>
                new Chart(document.getElementById('overallDonutChart'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Keldi', 'Qolgan'],
                        datasets: [{
                            data: [overallPercentage, Math.max(0, 100 - overallPercentage)],
                            backgroundColor: [overallPercentage >= 75 ? '#0E7C66' : '#C0392B', '#E6ECEA'],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        cutout: '75%',
                        plugins: { legend: { display: false } }
                    },
                    plugins: [centerTextPlugin]
                });
            </script>
        }

        @if (weeklyTrend != null && weeklyTrend.Any())
        {
            <script>
                new Chart(document.getElementById('weeklyTrendChart'), {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(weeklyTrend.Select(w => w.WeekStart.ToString("dd.MM")))),
                        datasets: [{
                            label: 'Davomat %',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(weeklyTrend.Select(w => w.Percentage))),
                            borderColor: '#0E7C66',
                            backgroundColor: 'rgba(14, 124, 102, 0.12)',
                            pointBackgroundColor: '#0E7C66',
                            pointBorderColor: '#fff',
                            fill: true,
                            tension: 0.35,
                            pointRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: { y: { beginAtZero: true, max: 100 } },
                        plugins: { legend: { display: false } }
                    }
                });
            </script>
        }

        @if (examLabels != null && examLabels.Any())
        {
            <script>
                const examLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ExamLabels));
                const examAverages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ExamAverages));

                new Chart(document.getElementById('examChart'), {
                    type: 'bar',
                    data: {
                        labels: examLabels,
                        datasets: [{
                            label: "O'rtacha ball (%)",
                            data: examAverages,
                            backgroundColor: 'rgba(14, 124, 102, 0.85)',
                            hoverBackgroundColor: '#0A5F4F',
                            borderRadius: 8,
                            borderSkipped: false,
                            maxBarThickness: 52
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: { y: { beginAtZero: true, max: 100 } },
                        plugins: { legend: { display: false } }
                    }
                });
            </script>
        }
    }
}