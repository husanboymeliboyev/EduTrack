@model EduTrack.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "Foydalanuvchini tahrirlash";
    var isAdmin = User.IsInRole("Admin");
}

<h1>Foydalanuvchini tahrirlash</h1>

<form asp-action="Edit">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="form-group mb-3">
        <label class="control-label">Email</label>
        <input value="@Model.Email" class="form-control" disabled />
    </div>

    <div class="form-group mb-3">
        <label asp-for="FullName" class="control-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Role" class="control-label"></label>
        @if (isAdmin)
        {
            <select asp-for="Role" class="form-control" asp-items="ViewBag.Roles"></select>
            <span asp-validation-for="Role" class="text-danger"></span>
        }
        else
        {
            <input type="hidden" asp-for="Role" />
            <input value="@Model.Role" class="form-control" disabled />
            <small class="form-text text-muted">Rolni faqat admin o'zgartira oladi.</small>
        }
    </div>

    <div class="form-group mb-3" id="studentGroupFields">
        <div class="row g-2">
            <div class="col-md-6">
                <label asp-for="ClassGroupId" class="control-label"></label>
                <select asp-for="ClassGroupId" class="form-control" asp-items="ViewBag.ClassGroups">
                    <option value="">-- Sinfni tanlang --</option>
                </select>
                <span asp-validation-for="ClassGroupId" class="text-danger"></span>
                <small class="form-text text-muted">1-smena: sinf kesimida.</small>
            </div>
            <div class="col-md-6">
                <label asp-for="StreamGroupId" class="control-label"></label>
                <select asp-for="StreamGroupId" class="form-control" asp-items="ViewBag.StreamGroups">
                    <option value="">-- Guruhni tanlang --</option>
                </select>
                <span asp-validation-for="StreamGroupId" class="text-danger"></span>
                <small class="form-text text-muted">2-smena: guruh kesimida.</small>
            </div>
        </div>
        <small class="form-text text-muted">Ikkalasi ham faqat "Student" roli uchun majburiy.</small>
    </div>

    <button type="submit" class="btn btn-primary">Saqlash</button>
    <a asp-action="Index" class="btn btn-secondary">Bekor qilish</a>
</form>

@section Scripts {
    <script>
        (function () {
            var role = document.querySelector('[name="Role"]');
            var box = document.getElementById('studentGroupFields');
            var classSelect = document.getElementById('ClassGroupId');
            var streamSelect = document.getElementById('StreamGroupId');

            function toggle() {
                var isStudent = role && role.value === 'Student';
                if (box) { box.style.display = isStudent ? '' : 'none'; }
                if (classSelect) { classSelect.required = isStudent; }
                if (streamSelect) { streamSelect.required = isStudent; }
            }

            if (role) { role.addEventListener('change', toggle); }
            toggle();
        })();
    </script>
}