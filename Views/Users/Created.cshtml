@model EduTrack.ViewModels.UserCredentialsViewModel

@{
    ViewData["Title"] = "Foydalanuvchi yaratildi";
}

<h1>Foydalanuvchi muvaffaqiyatli yaratildi</h1>

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle"></i>
    Bu ma'lumotlar faqat <strong>hozir, shu sahifada</strong> ko'rinadi — parolni qayta ko'rish imkoni bo'lmaydi.
    Uni hozir nusxalab, foydalanuvchiga (@Model.FullName) yetkazing.
</div>

<div class="card" style="max-width: 480px;">
    <div class="card-body">
        <h5 class="card-title">@Model.FullName</h5>
        <p class="text-muted mb-3">Rol: @Model.Role</p>

        <div class="mb-3">
            <label class="form-label text-muted small">Login ID</label>
            <div class="input-group">
                <input type="text" class="form-control" value="@Model.LoginId" id="loginIdField" readonly />
                <button class="btn btn-outline-secondary" type="button" onclick="copyField('loginIdField')">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label text-muted small">Parol</label>
            <div class="input-group">
                <input type="text" class="form-control" value="@Model.Password" id="passwordField" readonly />
                <button class="btn btn-outline-secondary" type="button" onclick="copyField('passwordField')">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> Yana bittasini qo'shish
    </a>
    <a asp-action="Index" class="btn btn-secondary">Foydalanuvchilar ro'yxatiga qaytish</a>
</div>

@section Scripts {
    <script>
        function copyField(id) {
            var field = document.getElementById(id);
            field.select();
            navigator.clipboard.writeText(field.value);
        }
    </script>
}