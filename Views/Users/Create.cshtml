@model EduTrack.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Yangi foydalanuvchi";
}

<h1>Yangi foydalanuvchi qo'shish</h1>

<div class="alert alert-info">
    <i class="bi bi-info-circle"></i>
    Login ID va parol tizim tomonidan avtomatik yaratiladi — ularni saqlashning hojati yo'q,
    keyingi sahifada ko'rinadi.
</div>

<form asp-action="Create">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="FullName" class="control-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Email" class="control-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Role" class="control-label"></label>
        <select asp-for="Role" class="form-control" asp-items="ViewBag.Roles">
            <option value="">-- Tanlang --</option>
        </select>
        <span asp-validation-for="Role" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="GroupId" class="control-label"></label>
        <select asp-for="GroupId" class="form-control" asp-items="ViewBag.Groups">
            <option value="">-- Tanlanmagan --</option>
        </select>
        <small class="form-text text-muted">Faqat "Student" roli tanlanganda ishlatiladi.</small>
    </div>
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> Yaratish
    </button>
    <a asp-action="Index" class="btn btn-secondary">Bekor qilish</a>
</form>