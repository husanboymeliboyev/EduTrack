@model EduTrack.ViewModels.UsersPageViewModel

@{
    ViewData["Title"] = "Foydalanuvchilar";
}

<h1>Foydalanuvchilar</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["NewPasswordValue"] != null)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i>
        <strong>@TempData["NewPasswordFullName"]</strong> uchun yangi vaqtinchalik parol generatsiya qilindi.
        Bu ma'lumot faqat <strong>hozir, shu sahifada</strong> ko'rinadi — keyin qayta ko'rish imkoni bo'lmaydi.
        Uni hozir nusxalab, foydalanuvchiga yetkazing.

        <div class="row mt-3" style="max-width: 480px;">
            <div class="col-6">
                <label class="form-label text-muted small">Login ID</label>
                <div class="input-group">
                    <input type="text" class="form-control" value="@TempData["NewPasswordLoginId"]" id="resetLoginIdField" readonly />
                    <button class="btn btn-outline-secondary" type="button" onclick="copyField('resetLoginIdField')">
                        <i class="bi bi-clipboard"></i>
                    </button>
                </div>
            </div>
            <div class="col-6">
                <label class="form-label text-muted small">Yangi parol</label>
                <div class="input-group">
                    <input type="text" class="form-control" value="@TempData["NewPasswordValue"]" id="resetPasswordField" readonly />
                    <button class="btn btn-outline-secondary" type="button" onclick="copyField('resetPasswordField')">
                        <i class="bi bi-clipboard"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">+ Yangi foydalanuvchi qo'shish</a>
</p>

<partial name="_UserDirectory" model="Model" />

@section Scripts {
    <script>
        function copyField(id) {
            var field = document.getElementById(id);
            field.select();
            navigator.clipboard.writeText(field.value);
        }

        document.querySelectorAll('form.js-reset-password').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                var name = form.getAttribute('data-name') || '';
                var message = 'Rostdan ham ' + name +
                    ' ning parolini tiklamoqchimisiz? Yangi vaqtinchalik parol generatsiya qilinadi.';

                if (!confirm(message)) {
                    event.preventDefault();
                }
            });
        });
    </script>
}
