@model List<EduTrack.ViewModels.ParentChildViewModel>
@{
    Layout = null;
    ViewData["Title"] = "Farzandlarim";
}
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Farzandlarim - EduTrack</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --p-primary: #0E7C66;
            --p-primary-dark: #0A5F4F;
            --p-ink: #1C2321;
            --p-muted: #5A6663;
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            color: var(--p-ink);
            margin: 0;
            min-height: 100vh;
            background: radial-gradient(circle at 20% 10%, #12A085 0%, #0B6B58 45%, #073C31 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .panel {
            background: #ffffff;
            border-radius: 24px;
            padding: 34px;
            width: 100%;
            max-width: 520px;
            box-shadow: 0 24px 60px rgba(0,0,0,0.35);
        }
        .panel h1 {
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
            font-size: 1.5rem;
            margin-bottom: 6px;
        }
        .panel .lead {
            color: var(--p-muted);
            font-size: .93rem;
            margin-bottom: 24px;
        }
        .child-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            border: 1px solid #E1E7E5;
            border-radius: 16px;
            padding: 16px 18px;
            margin-bottom: 12px;
            text-decoration: none;
            color: var(--p-ink);
            transition: border-color .12s ease, box-shadow .12s ease;
        }
        .child-card:hover {
            border-color: var(--p-primary);
            box-shadow: 0 6px 16px rgba(14, 124, 102, 0.15);
            color: var(--p-ink);
        }
        .child-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: #E6F4F1;
            color: var(--p-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-family: 'Manrope', sans-serif;
            flex-shrink: 0;
        }
        .child-name { font-weight: 700; }
        .child-group { color: var(--p-muted); font-size: .85rem; }
        .empty {
            text-align: center;
            color: var(--p-muted);
            padding: 30px 0;
        }
        .logout-form { margin-top: 18px; }
        .btn-logout {
            width: 100%;
            background: transparent;
            border: 1px solid #E1E7E5;
            color: var(--p-muted);
            font-weight: 600;
            padding: 11px;
            border-radius: 12px;
        }
        .btn-logout:hover { border-color: #C0392B; color: #C0392B; }
    </style>
</head>
<body>
    <div class="panel">
        <h1>Farzandlarim</h1>
        <p class="lead">Natijalarini ko'rish uchun farzandingizni tanlang.</p>

        @if (!Model.Any())
        {
            <div class="empty">
                <i class="bi bi-people" style="font-size: 2rem;"></i>
                <p class="mb-0 mt-2">Hozircha sizga hech qanday farzand bog'lanmagan.<br />Maktab ma'muriyatiga murojaat qiling.</p>
            </div>
        }
        else
        {
            @foreach (var child in Model)
            {
                <a class="child-card" asp-controller="ParentPortal" asp-action="StudentReport" asp-route-studentId="@child.StudentId">
                    <div class="d-flex align-items-center gap-3">
                        @{
                            var initial = string.IsNullOrWhiteSpace(child.FullName) ? "?" : child.FullName.Trim().Substring(0, 1).ToUpper();
                        }
                        <div class="child-avatar">@initial</div>
                        <div>
                            <div class="child-name">@child.FullName</div>
                            <div class="child-group">@(string.IsNullOrEmpty(child.GroupName) ? "Guruh belgilanmagan" : child.GroupName)</div>
                        </div>
                    </div>
                    <i class="bi bi-arrow-right"></i>
                </a>
            }
        }

        <form class="logout-form" asp-controller="ParentPortal" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-logout">
                <i class="bi bi-box-arrow-right"></i> Chiqish
            </button>
        </form>
    </div>
</body>
</html>
