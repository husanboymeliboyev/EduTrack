@model EduTrack.ViewModels.ParentDashboardViewModel
@{
    ViewData["Title"] = "Ota-ona paneli";
    var report = Model.Report;
    var statusText = report?.StatusZone switch
    {
        "Green" => "Yaxshi holatda",
        "Red" => "E'tibor talab etiladi",
        _ => "Kuzatuvda"
    };
}

<div class="container py-4 parent-dashboard">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="text-uppercase small text-muted fw-semibold">EduTrack</span>
            <h1 class="h3 mb-1">Ota-ona paneli</h1>
            <p class="text-muted mb-0">Farzandingizning ta'lim natijalarini bir joyda kuzating.</p>
        </div>
        <form asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary">Chiqish</button>
        </form>
    </div>

    @if (Model.Children.Count == 0)
    {
        <div class="card border-0 shadow-sm p-4 text-center">
            <h2 class="h5">Sizda bog‘langan farzandlar mavjud emas</h2>
            <p class="text-muted mb-0">Farzandingizni akkauntingizga bog‘lash uchun administratorga murojaat qiling.</p>
        </div>
    }
    else
    {
        <form asp-action="Dashboard" method="get" class="card border-0 shadow-sm p-3 mb-4">
            <label for="childId" class="form-label fw-semibold">Farzandni tanlang</label>
            <div class="d-flex flex-column flex-md-row gap-2">
                <select id="childId" name="childId" class="form-select" aria-label="Farzandni tanlang">
                    @foreach (var child in Model.Children)
                    {
                        <option value="@child.StudentId" selected="@(child.StudentId == Model.SelectedChildId)">
                            @child.StudentName@if (!string.IsNullOrWhiteSpace(child.GroupName)) { <text> — @child.GroupName</text> }
                        </option>
                    }
                </select>
                <button type="submit" class="btn btn-primary px-4">Ko‘rsatish</button>
            </div>
        </form>

        @if (report is not null)
        {
            <section class="parent-report-hero rounded-4 p-4 p-md-5 text-white mb-4">
                <div class="row align-items-end g-4">
                    <div class="col-lg-7">
                        <p class="text-white-50 text-uppercase small fw-semibold mb-2">Umumiy diagnostik xulosa</p>
                        <h2 class="display-6 fw-bold mb-2">@report.StudentName</h2>
                        <p class="text-white-50 mb-0">@report.GroupName</p>
                    </div>
                    <div class="col-lg-5 text-lg-end">
                        <div class="display-4 fw-bold">@report.OverallScore.ToString("0.#")<span class="fs-4 text-white-50">/100</span></div>
                        <span class="badge rounded-pill bg-light text-dark px-3 py-2">@statusText</span>
                    </div>
                </div>
            </section>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <div class="card border-0 shadow-sm h-100 p-4">
                        <span class="small text-muted">O‘zlashtirish</span>
                        <strong class="fs-3 mt-2">@report.GradeScore.ToString("0.#")%</strong>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card border-0 shadow-sm h-100 p-4">
                        <span class="small text-muted">Davomat</span>
                        <strong class="fs-3 mt-2">@report.AttendancePercentage.ToString("0.#")%</strong>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card border-0 shadow-sm h-100 p-4">
                        <span class="small text-muted">Topshiriqlar</span>
                        <strong class="fs-3 mt-2">@report.AssignmentCompletionPercentage.ToString("0.#")%</strong>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 mb-0">Fanlar bo‘yicha ko‘rsatkich</h2>
                    <span class="text-muted small">@report.SubjectBreakdown.Count ta fan</span>
                </div>
                @if (report.SubjectBreakdown.Count == 0)
                {
                    <p class="text-muted mb-0">Hozircha fanlar bo‘yicha ma’lumot mavjud emas.</p>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var subject in report.SubjectBreakdown)
                        {
                            <div class="col-12 col-sm-6 col-lg-4">
                                <div class="border rounded-3 p-3 h-100">
                                    <div class="d-flex justify-content-between gap-2 mb-2">
                                        <span class="fw-semibold">@subject.SubjectName</span>
                                        <span class="text-primary fw-bold">@subject.Percentage.ToString("0.#")%</span>
                                    </div>
                                    <div class="progress" role="progressbar" aria-label="@subject.SubjectName natijasi" aria-valuenow="@subject.Percentage" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar" style="width: @subject.Percentage.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="card border-0 shadow-sm p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <p class="text-uppercase small text-muted fw-semibold mb-1">Shaffof natijalar</p>
                        <h2 class="h5 mb-0">Baholash tafsilotlari</h2>
                    </div>
                    <span class="badge rounded-pill text-bg-light">@report.GradeDetails.Count ta komponent</span>
                </div>
                @if (report.GradeDetails.Count == 0)
                {
                    <p class="text-muted mb-0">Hozircha baholash tafsilotlari mavjud emas.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Fan / komponent</th>
                                    <th>Manba</th>
                                    <th>Holat</th>
                                    <th class="text-end">Natija</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detail in report.GradeDetails)
                                {
                                    var statusClass = detail.Status == "Baholangan" ? "text-bg-success" : detail.Status == "Kutilmoqda" ? "text-bg-warning" : "text-bg-secondary";
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@detail.ComponentName</div>
                                            <small class="text-muted">@detail.SubjectName · @detail.AssessmentType</small>
                                        </td>
                                        <td class="text-muted">@detail.Source</td>
                                        <td><span class="badge rounded-pill @statusClass">@detail.Status</span></td>
                                        <td class="text-end">
                                            @if (detail.Status == "Baholangan")
                                            {
                                                <div class="fw-semibold">@detail.EffectiveScore.ToString("0.#")/@detail.MaxScore.ToString("0.#")</div>
                                                @if (detail.RawScore.HasValue)
                                                {
                                                    <small class="text-muted">Manba: @detail.RawScore.Value.ToString("0.#")/100</small>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="small text-muted mt-3 mb-0">Komponent bali umumiy o‘zlashtirish ko‘rsatkichiga o‘zining maksimal bali bo‘yicha qo‘shiladi.</p>
                }
            </div>

            <div class="card border-0 shadow-sm p-4">
                <p class="text-uppercase small text-muted fw-semibold mb-2">Bir qarashda</p>
                <h2 class="h5">Umumiy daraja</h2>
                <p class="text-muted mb-0">Natija fanlar, davomat, topshiriqlar va o‘sish dinamikasi asosida shakllantiriladi.</p>
            </div>
        }
    }
</div>
