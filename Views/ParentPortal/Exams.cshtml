@model EduTrack.ViewModels.ParentExamsViewModel
@{
    ViewData["Title"] = "Imtihon natijalari";

    string PercentageBadge(double percentage) => percentage >= 86 ? "bg-success-subtle text-success-emphasis"
        : percentage >= 70 ? "bg-primary-subtle text-primary-emphasis"
        : percentage >= 50 ? "bg-warning-subtle text-warning-emphasis"
        : "bg-danger-subtle text-danger-emphasis";
}

<h1>Imtihon natijalari</h1>
<div class="iz-signature-line"></div>

@await Html.PartialAsync("_ChildHeader", Model)

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body">
                <div class="text-muted small mb-1"><i class="bi bi-clipboard-data"></i> Jami natija</div>
                <div class="fs-4 fw-bold">@Model.Results.Count</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body">
                <div class="text-muted small mb-1"><i class="bi bi-bar-chart"></i> O'rtacha</div>
                <div class="fs-4 fw-bold">@Model.AveragePercentage.ToString("0.#")%</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body">
                <div class="text-muted small mb-1"><i class="bi bi-trophy"></i> Eng yaxshi</div>
                <div class="fs-4 fw-bold text-success">@Model.BestPercentage.ToString("0.#")%</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body">
                <div class="text-muted small mb-1"><i class="bi bi-hourglass-split"></i> Tasdiq kutilmoqda</div>
                <div class="fs-4 fw-bold text-warning">@Model.PendingCount</div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Results.Any())
{
    <div class="iz-empty">
        <i class="bi bi-clipboard-x"></i>
        <p>Hozircha imtihon natijalari mavjud emas.</p>
    </div>
}
else
{
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-borderless align-middle mb-0">
                    <thead>
                        <tr class="text-muted small">
                            <th>Imtihon</th>
                            <th>Fan</th>
                            <th class="text-center">To'g'ri javob</th>
                            <th class="text-center">Foiz</th>
                            <th>Sana</th>
                            <th class="text-end">Holat</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in Model.Results)
                        {
                            <tr>
                                <td class="fw-medium">@result.ExamTitle</td>
                                <td>@(string.IsNullOrWhiteSpace(result.SubjectName) ? "—" : result.SubjectName)</td>
                                <td class="text-center">@result.CorrectAnswers / @result.TotalQuestions</td>
                                <td class="text-center">
                                    <span class="badge @PercentageBadge(result.Percentage)">@result.Percentage.ToString("0.#")%</span>
                                </td>
                                <td class="text-nowrap">@result.CompletedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end">
                                    <span class="badge @result.StatusClass">@result.StatusLabel</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
