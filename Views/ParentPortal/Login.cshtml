@{
    Layout = null;
    ViewData["Title"] = "Natijaga kirish";
}
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Natijaga kirish - EduTrack</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
            :root {
                --iz-primary: #0E7C66;
                --iz-primary-dark: #0A5F4F;
                --iz-primary-tint: #E6F4F1;
                --iz-ink: #1C2321;
                --iz-ink-muted: #5A6663;
                --iz-danger-text: #C0392B;
                --iz-danger-bg: #FBEAE8;
            }

            * {
                box-sizing: border-box;
            }

            html, body {
                height: 100%;
            }

            body {
                font-family: 'Inter', sans-serif;
                color: var(--iz-ink);
                margin: 0;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
                overflow: hidden;
                background: radial-gradient(circle at 15% 15%, #103b32 0%, #0a2621 42%, #071b18 100%);
            }

            .blob {
                position: absolute;
                border-radius: 50%;
                filter: blur(70px);
                opacity: .55;
                pointer-events: none;
            }

            .blob-1 {
                width: 480px;
                height: 480px;
                background: #14a085;
                top: -140px;
                left: -120px;
            }

            .blob-2 {
                width: 420px;
                height: 420px;
                background: #d68b2e;
                bottom: -160px;
                right: -100px;
                opacity: .35;
            }

            .blob-3 {
                width: 300px;
                height: 300px;
                background: #1c6e5c;
                top: 40%;
                right: 8%;
                opacity: .3;
            }

            .grain-dots {
                position: absolute;
                inset: 0;
                background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px);
                background-size: 26px 26px;
                pointer-events: none;
            }

            .login-wrap {
                position: relative;
                z-index: 2;
                width: 100%;
                max-width: 420px;
                padding: 24px;
            }

            .brand {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 12px;
                margin-bottom: 28px;
            }

            .brand-icon {
                width: 46px;
                height: 46px;
                border-radius: 14px;
                background: linear-gradient(135deg, #14a085, #0A5F4F);
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-size: 1.4rem;
                box-shadow: 0 8px 20px rgba(14, 124, 102, 0.45);
            }

            .brand-name {
                font-family: 'Manrope', sans-serif;
                font-weight: 800;
                font-size: 1.4rem;
                color: #fff;
                letter-spacing: .2px;
            }

            .login-card {
                background: #ffffff;
                border-radius: 24px;
                padding: 36px 34px 30px;
                box-shadow: 0 24px 60px rgba(0,0,0,0.35);
            }

                .login-card h1 {
                    font-family: 'Manrope', sans-serif;
                    font-weight: 800;
                    font-size: 1.55rem;
                    margin-bottom: 8px;
                }

                .login-card p.lead-text {
                    color: var(--iz-ink-muted);
                    font-size: .93rem;
                    line-height: 1.55;
                    margin-bottom: 26px;
                }

            .form-label {
                font-size: .78rem;
                font-weight: 700;
                letter-spacing: .04em;
                text-transform: uppercase;
                color: var(--iz-ink-muted);
                margin-bottom: 6px;
            }

            .form-control {
                border-radius: 12px;
                border: 1.5px solid #E1E7E5;
                padding: 11px 14px;
                font-size: .98rem;
            }

                .form-control:focus {
                    border-color: var(--iz-primary);
                    box-shadow: 0 0 0 3px var(--iz-primary-tint);
                }

            .password-field {
                position: relative;
            }

            .toggle-password {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                color: var(--iz-ink-muted);
                cursor: pointer;
                font-size: 1.05rem;
            }

            .btn-login {
                width: 100%;
                background: linear-gradient(135deg, var(--iz-primary), var(--iz-primary-dark));
                border: none;
                color: #fff;
                font-weight: 700;
                padding: 13px;
                border-radius: 12px;
                font-size: 1rem;
                margin-top: 6px;
                transition: transform .12s ease, box-shadow .12s ease;
                box-shadow: 0 10px 24px rgba(14, 124, 102, 0.35);
            }

                .btn-login:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 14px 30px rgba(14, 124, 102, 0.45);
                    color: #fff;
                }

            .alert-error {
                background: var(--iz-danger-bg);
                color: var(--iz-danger-text);
                border-radius: 12px;
                padding: 12px 16px;
                font-size: .9rem;
                margin-bottom: 20px;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .foot-note {
                text-align: center;
                color: rgba(255,255,255,0.6);
                font-size: .82rem;
                margin-top: 22px;
            }

                .foot-note a {
                    color: rgba(255,255,255,0.85);
                    text-decoration: none;
                    font-weight: 600;
                }

                    .foot-note a:hover {
                        color: #fff;
                    }
    </style>
</head>
<body>
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
    <div class="grain-dots"></div>

    <div class="login-wrap">
        <div class="brand">
            <div class="brand-icon"><i class="bi bi-mortarboard-fill"></i></div>
            <div class="brand-name">EduTrack</div>
        </div>

        <div class="login-card">
            <h1>Natijaga kirish</h1>
            <p class="lead-text">
                Ota-ona sifatida farzandingizning o'zlashtirish ko'rsatkichlarini ko'rish uchun
                uning kirish kodi va parolini kiriting.
            </p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-error">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>@ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage</span>
                </div>
            }

            <form asp-controller="ParentPortal" asp-action="Login" method="post">
                <div class="mb-3">
                    <label class="form-label">Kirish kodi</label>
                    <input type="text" name="loginId" class="form-control" placeholder="Masalan: 10024" autofocus autocomplete="username" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Parol</label>
                    <div class="password-field">
                        <input type="password" name="password" id="passwordInput" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                        <button type="button" class="toggle-password" onclick="togglePassword()">
                            <i class="bi bi-eye" id="toggleIcon"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-login mt-3">
                    <i class="bi bi-box-arrow-in-right"></i> Kirish
                </button>
            </form>
        </div>

        <p class="foot-note">Kirish kodingizni bilmasangiz, sinf rahbariga murojaat qiling.</p>
    </div>

    <script>
            function togglePassword() {
                const input = document.getElementById('passwordInput');
                const icon = document.getElementById('toggleIcon');
                const isHidden = input.type === 'password';
                input.type = isHidden ? 'text' : 'password';
                icon.className = isHidden ? 'bi bi-eye-slash' : 'bi bi-eye';
            }
    </script>
</body>
</html>
