@using EduTrack.ViewModels
@model EduTrack.ViewModels.UsersPageViewModel

@*
    Admin «Foydalanuvchilar» va o'qituvchi «Talabalar» sahifalari uchun umumiy
    filtr + jadval + sahifalash bloki. Havolalar asp-controller'siz yozilgan,
    shuning uchun joriy controller'ga (Users yoki Students) bog'lanadi.
*@

@{
    var itemLabel = Model.IsTeacherScope ? "talaba" : "foydalanuvchi";
}

<form method="get" asp-action="Index" class="card card-body mb-3">
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label" for="Search">Qidiruv</label>
            <input class="form-control"
                   id="Search"
                   name="Search"
                   value="@Model.Filter.Search"
                   placeholder="Ism, login yoki email" />
        </div>

        @if (!Model.IsTeacherScope)
        {
            <div class="col-md-2">
                <label class="form-label" for="Role">Rol</label>
                <select class="form-select" id="Role" name="Role">
                    <option value="">Barchasi</option>
                    @foreach (var role in Model.Roles)
                    {
                        <option value="@role"
                                selected="@(Model.Filter.Role == role ? "selected" : null)">
                            @role
                        </option>
                    }
                </select>
            </div>
        }

        <div class="col-md-2">
            <label class="form-label" for="GroupId">Guruh</label>
            <select class="form-select" id="GroupId" name="GroupId">
                <option value="">Barchasi</option>
                @foreach (var group in Model.Groups)
                {
                    <option value="@group.Id"
                            selected="@(Model.Filter.GroupId == group.Id ? "selected" : null)">
                        @group.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label" for="Sort">Tartiblash</label>
            <select class="form-select" id="Sort" name="Sort">
                <option value="@UsersSort.NameAsc"
                        selected="@(Model.Filter.Sort == UsersSort.NameAsc ? "selected" : null)">
                    Ism (A → Z)
                </option>
                <option value="@UsersSort.NameDesc"
                        selected="@(Model.Filter.Sort == UsersSort.NameDesc ? "selected" : null)">
                    Ism (Z → A)
                </option>
                <option value="@UsersSort.LoginAsc"
                        selected="@(Model.Filter.Sort == UsersSort.LoginAsc ? "selected" : null)">
                    Login (o'sish)
                </option>
                <option value="@UsersSort.LoginDesc"
                        selected="@(Model.Filter.Sort == UsersSort.LoginDesc ? "selected" : null)">
                    Login (kamayish)
                </option>
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label" for="PageSize">Sahifa hajmi</label>
            <select class="form-select" id="PageSize" name="PageSize">
                @foreach (var size in UsersFilterViewModel.AllowedPageSizes)
                {
                    <option value="@size"
                            selected="@(Model.Filter.PageSize == size ? "selected" : null)">
                        @size
                    </option>
                }
            </select>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mt-3">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-funnel"></i> Filtrlash
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            Tozalash
        </a>
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <div class="iz-empty">
        <i class="bi bi-person-badge"></i>
        <p>
            @if (Model.Filter.HasActiveFilters)
            {
                @($"Filtrga mos {itemLabel} topilmadi.")
            }
            else if (Model.IsTeacherScope)
            {
                @("Sizning guruhlaringizda hozircha talaba yo'q.")
            }
            else
            {
                @("Hozircha foydalanuvchilar yo'q.")
            }
        </p>
    </div>

    @if (Model.Filter.HasActiveFilters)
    {
        <div class="text-center mt-2">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                Filtrlarni tozalash
            </a>
        </div>
    }
}
else
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <span class="text-muted">@Model.TotalCount ta @itemLabel</span>
        <span class="text-muted ms-auto">Sahifa @Model.Page / @Model.TotalPages</span>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead>
                <tr>
                    <th>Ism-familiya</th>
                    <th>Login ID</th>
                    <th>Email</th>
                    @if (!Model.IsTeacherScope)
                    {
                        <th>Rol</th>
                    }
                    <th>Guruh</th>
                    @if (!Model.IsTeacherScope)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Rows)
                {
                    <tr>
                        <td>@item.FullName</td>
                        <td><code>@item.LoginId</code></td>
                        <td>@item.Email</td>
                        @if (!Model.IsTeacherScope)
                        {
                            <td>
                                @{
                                    var badgeClass = item.Role switch
                                    {
                                        "Admin" => "bg-warning",
                                        "Teacher" => "bg-info",
                                        "Student" => "bg-success",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@item.Role</span>
                            </td>
                        }
                        <td>@(item.GroupName ?? "-")</td>
                        @if (!Model.IsTeacherScope)
                        {
                            <td class="text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Tahrirlash</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">O'chirish</a>
                                <form asp-action="ResetPassword" method="post" class="d-inline js-reset-password"
                                      data-name="@item.FullName">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@item.Id" />
                                    <input type="hidden"
                                           name="returnUrl"
                                           value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-key"></i> Parolni tiklash
                                    </button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        var start = Math.Max(1, Model.Page - 2);
        var end = Math.Min(Model.TotalPages, start + 4);
        start = Math.Max(1, end - 4);

        <nav class="mt-3" aria-label="Ro'yxat sahifalari">
            <ul class="pagination mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : string.Empty)">
                    <a class="page-link"
                       asp-action="Index"
                       asp-all-route-data="@Model.ToRouteValues(Model.Page - 1)">
                        Oldingi
                    </a>
                </li>

                @if (start > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-all-route-data="@Model.ToRouteValues(1)">1</a>
                    </li>
                    @if (start > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }

                @for (var p = start; p <= end; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : string.Empty)">
                        <a class="page-link"
                           asp-action="Index"
                           asp-all-route-data="@Model.ToRouteValues(p)">@p</a>
                    </li>
                }

                @if (end < Model.TotalPages)
                {
                    @if (end < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-all-route-data="@Model.ToRouteValues(Model.TotalPages)">@Model.TotalPages</a>
                    </li>
                }

                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : string.Empty)">
                    <a class="page-link"
                       asp-action="Index"
                       asp-all-route-data="@Model.ToRouteValues(Model.Page + 1)">
                        Keyingi
                    </a>
                </li>
            </ul>
        </nav>
    }
}
