@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduTrack</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎓</text></svg>" />
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EduTrack.styles.css" asp-append-version="true" />
    <!-- KaTeX CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
</head>
<body>
    <div class="iz-shell">
        <aside class="iz-sidebar" id="izSidebar">
            <div class="iz-sidebar-brand">
                <i class="bi bi-mortarboard-fill"></i> EduTrack
            </div>

            <nav class="iz-sidebar-nav">
                <a class="iz-nav-item" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door"></i> Bosh sahifa
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <div class="iz-nav-group-label">Boshqaruv</div>
                    <a class="iz-nav-item" asp-area="" asp-controller="Groups" asp-action="Index">
                        <i class="bi bi-people"></i> Guruhlar
                    </a>
                    <a class="iz-nav-item" asp-area="" asp-controller="Subjects" asp-action="Index">
                        <i class="bi bi-journal-bookmark"></i> Fanlar
                    </a>
                    <a class="iz-nav-item" asp-area="" asp-controller="Users" asp-action="Index">
                        <i class="bi bi-person-badge"></i> Foydalanuvchilar
                    </a>                    
                    <a class="iz-nav-item" asp-area="" asp-controller="Schedule" asp-action="Index">
                        <i class="bi bi-calendar3"></i> Dars jadvali
                    </a>
                    <a class="iz-nav-item" asp-area="" asp-controller="AdminAnalytics" asp-action="Index">
                        <i class="bi bi-bar-chart-line"></i> Analitika
                    </a>
                    <a class="iz-nav-item" asp-area="" asp-controller="AdminShowcase" asp-action="Index">
                        <i class="bi bi-stars"></i> Talaba Ko'rgazmasi
                    </a>
                }

                @if (User.IsInRole("Teacher"))
                {
                    <div class="iz-nav-group-label">O'quv jarayoni</div>
                    <a class="iz-nav-item" asp-area="" asp-controller="Attendance" asp-action="Index">
                        <i class="bi bi-calendar-check"></i> Davomat
                    </a>
                    
                    <a class="iz-nav-item" asp-area="" asp-controller="Grading" asp-action="Index">
                        <i class="bi bi-award"></i> Baholash
                    </a>
                    <a class="iz-nav-item" asp-area="" asp-controller="Schedule" asp-action="MySchedule">
                        <i class="bi bi-calendar3"></i> Dars jadvalim
                    </a>
                    <a class="iz-nav-item" asp-area="" asp-controller="Assignments" asp-action="Index">
                        <i class="bi bi-clipboard-check"></i> Topshiriqlar
                    </a>
                    <div class="iz-nav-group-label">Imtihonlar</div>
                    <a class="iz-nav-item" asp-area="" asp-controller="QuestionBanks" asp-action="Index">
                        <i class="bi bi-collection"></i> Savollar banki
                    </a>
                    <a class="iz-nav-item" asp-area="" asp-controller="Questions" asp-action="Index">
                        <i class="bi bi-patch-question"></i> Barcha savollar
                    </a>
                    <a class="iz-nav-item" asp-area="" asp-controller="Exams" asp-action="Index">
                        <i class="bi bi-clipboard-data"></i> Imtihonlar
                    </a>
                }
                @if (User.IsInRole("Student"))
                {
                    <div class="iz-nav-group-label">Mening o'quvim</div>
                    <a class="iz-nav-item" asp-area="" asp-controller="Schedule" asp-action="MyGroupSchedule">
                        <i class="bi bi-calendar3"></i> Dars jadvali
                    </a>
                    <a class="iz-nav-item" asp-area="" asp-controller="StudentSubmissions" asp-action="Index">
                        <i class="bi bi-clipboard-check"></i> Topshiriqlar
                        @await Component.InvokeAsync("SidebarBadge", new { type = "assignments" })
                    </a>
                    <a class="iz-nav-item" asp-area="" asp-controller="StudentExams" asp-action="Index">
                        <i class="bi bi-clipboard-data"></i> Imtihonlar
                    </a>
                    <a class="iz-nav-item" asp-area="" asp-controller="StudentGrades" asp-action="Index">
                        <i class="bi bi-award"></i> Baholarim
                    </a>
                    <a class="iz-nav-item" asp-area="" asp-controller="StudentGrades" asp-action="Rating">
                        <i class="bi bi-bar-chart"></i> Reyting
                    </a>
                }
                

            </nav>

            <div class="iz-sidebar-footer">
                @if (SignInManager.IsSignedIn(User))
                {
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="iz-nav-item iz-nav-logout">
                            <i class="bi bi-box-arrow-right"></i> Chiqish
                        </button>
                    </form>
                }
            </div>
        </aside>
        <div class="iz-backdrop" id="izBackdrop"></div>
        <div class="iz-main">
            <header class="iz-topbar">
                <button type="button" class="iz-hamburger" id="izSidebarToggle" aria-label="Menyuni ochish" aria-controls="izSidebar" aria-expanded="false">
                    <i class="bi bi-list"></i>
                </button>
                <div class="iz-topbar-spacer"></div>
                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="dropdown">
                        <a class="iz-user dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="iz-avatar @(User.IsInRole("Admin") ? "iz-avatar-admin" : User.IsInRole("Teacher") ? "iz-avatar-teacher" : "iz-avatar-student")">
                                @(User.Identity?.Name?.Substring(0, 1).ToUpper())
                            </span>
                            <span class="iz-user-name d-none d-sm-inline">@User.Identity?.Name</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                                    <i class="bi bi-person"></i> Profil
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/ChangePassword">
                                    <i class="bi bi-key"></i> Parolni almashtirish
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Login">Kirish</a>
                }
            </header>

            <main class="iz-content">
                @RenderBody()
            </main>

            <footer class="iz-footer">
                &copy; 2026 - EduTrack
            </footer>
        </div>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- KaTeX JS -->
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            document.querySelectorAll('.question-latex').forEach(function(el) {
                renderMathInElement(el, {
                    delimiters: [
                        { left: '$$', right: '$$', display: true },
                        { left: '$', right: '$', display: false },
                        { left: '\\[', right: '\\]', display: true },
                        { left: '\\(', right: '\\)', display: false }
                    ],
                    throwOnError: false
                });
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>