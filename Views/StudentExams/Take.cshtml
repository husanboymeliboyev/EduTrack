@model EduTrack.ViewModels.TakeExamViewModel

@{
    ViewData["Title"] = "Imtihon: " + Model.Title;
    ViewData["ExamMode"] = true;
}

<div id="examStartOverlay" class="iz-exam-overlay">
    <div class="iz-exam-overlay-card">
        <h2>@Model.Title</h2>
        <p class="text-muted">@Model.SubjectName | @Model.Questions.Count ta savol | @Model.DurationMinutes daqiqa</p>
        <div class="alert alert-warning text-start">
            <strong>Diqqat:</strong> imtihon to'liq ekran (fullscreen) rejimida o'tkaziladi.
            Boshqa sahifaga/oynaga o'tsangiz yoki fullscreen'dan chiqsangiz, bu qayd etiladi
            va o'qituvchingizga ko'rinadi.
        </div>
        <button type="button" class="btn btn-primary btn-lg" id="startExamBtn">
            <i class="bi bi-play-fill"></i> Imtihonni boshlash
        </button>
    </div>
</div>

<div id="examContent" style="display:none;">
    <div class="exam-layout">
        <section class="exam-main" aria-label="Imtihon savollari">
            <div class="exam-header d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                <div>
                    <h1>@Model.Title</h1>
                    <p class="text-muted mb-0">@Model.SubjectName | @Model.Questions.Count ta savol</p>
                </div>
                <div class="text-end">
                    <div class="fs-3 fw-bold" id="timer">--:--</div>
                    <div class="text-muted">Qolgan vaqt</div>
                </div>
            </div>

            <div class="alert alert-warning exam-essential-warning">
                Diqqat: vaqt tugaganda javoblaringiz avtomatik yuboriladi. Yakunlash uchun pastdagi tugmani bosing.
            </div>

            <div id="violationBanner" class="alert alert-danger" style="display:none;">
                <i class="bi bi-exclamation-triangle"></i>
                <span id="violationText"></span>
            </div>

            <form asp-action="Submit" method="post" id="examForm">
        <input type="hidden" name="examId" value="@Model.ExamId" />
        <input type="hidden" name="tabSwitchCount" id="tabSwitchCountInput" value="0" />
        <input type="hidden" name="exitedFullscreen" id="exitedFullscreenInput" value="false" />

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            <input type="hidden" name="questionIds" value="@q.QuestionId" />
            <div class="card mb-3 question-card" id="question-@i" data-question-index="@i" tabindex="-1">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <h5 class="card-title question-latex" data-question-number="@(i + 1)">@(i + 1). @q.Text</h5>
                        <button type="button" class="btn btn-sm btn-outline-warning question-flag" data-question-index="@i" aria-pressed="false" aria-label="@(i + 1)-savolni belgilash">Belgila</button>
                    </div>
                    @if (!string.IsNullOrEmpty(q.ImagePath))
                    {
                        <img src="~/@q.ImagePath" alt="Savol rasmi" class="img-fluid mb-3 border rounded" style="max-width: 400px;" />
                    }
                    @foreach (var option in q.Options)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="radio"
                                   name="answers[@q.QuestionId]" value="@option.Id"
                                   id="opt_@option.Id" />
                            <label class="form-check-label question-latex" for="opt_@option.Id">@option.Text</label>
                        </div>
                    }
                </div>
            </div>
        }

                <button type="button" class="btn btn-primary btn-lg" id="submitBtn">Imtihonni yakunlash</button>
            </form>
        </section>

        <aside class="exam-sidebar" aria-labelledby="questionNavigatorTitle">
            <div id="questionNavigator" class="card" aria-labelledby="questionNavigatorTitle">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h2 id="questionNavigatorTitle" class="h5 mb-0">Savollar navigatori</h2>
                        <div id="questionNavigatorSummary" class="small text-muted" aria-live="polite"></div>
                    </div>
                    <div class="small text-muted mt-2" aria-hidden="true">
                        <span class="badge bg-primary">Joriy</span>
                        <span class="badge bg-success">Javoblangan</span>
                        <span class="badge bg-secondary">Javobsiz</span>
                        <span class="badge bg-warning text-dark">Belgilangan</span>
                    </div>
                    <div id="questionNavigatorButtons" class="d-flex flex-wrap gap-2 mt-2" role="list" aria-label="Imtihon savollari"></div>
                </div>
            </div>
        </aside>
    </div>
</div>

<!-- KaTeX global layout orqali ishlaydi -->
@section Scripts {
<style>
        #questionNavigatorButtons .question-nav-button { min-width: 2.75rem; }
        #questionNavigatorButtons .question-nav-button.is-current { outline: 3px solid var(--bs-primary); outline-offset: 2px; }
        #questionNavigatorButtons .question-nav-button.is-answered { background-color: var(--bs-success); color: #fff; }
        #questionNavigatorButtons .question-nav-button.is-unanswered { background-color: var(--bs-secondary); color: #fff; }
        #questionNavigatorButtons .question-nav-button.is-flagged { box-shadow: inset 0 0 0 3px var(--bs-warning); }
        .question-card.is-current { border-color: var(--bs-primary); box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .15); }
    </style>
    <script>
        (function() {
            var totalSeconds = @Model.RemainingSeconds;
            var timerEl = document.getElementById('timer');
            var form = document.getElementById('examForm');
            var submitted = false;
            var explicitSubmitRequested = false;
            var interval = null;
            var currentQuestionIndex = 0;
            var flaggedQuestions = new Set();
            var questionCards = Array.from(document.querySelectorAll('.question-card'));
            var navigatorButtons = document.getElementById('questionNavigatorButtons');
            var navigatorSummary = document.getElementById('questionNavigatorSummary');
            var submitBtn = document.getElementById('submitBtn');

            var tabSwitchCount = 0;
            var exitedFullscreen = false;
            var MAX_VIOLATIONS = 3;

            var overlay = document.getElementById('examStartOverlay');
            var content = document.getElementById('examContent');
            var startBtn = document.getElementById('startExamBtn');
            var banner = document.getElementById('violationBanner');
            var bannerText = document.getElementById('violationText');

            function render() {
                var m = Math.floor(totalSeconds / 60);
                var s = totalSeconds % 60;
                timerEl.textContent = (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);
                if (totalSeconds <= 60) {
                    timerEl.classList.add('text-danger');
                }
            }

            function doSubmit() {
                if (submitted) return;
                submitted = true;
                clearInterval(interval);
                document.getElementById('tabSwitchCountInput').value = tabSwitchCount;
                document.getElementById('exitedFullscreenInput').value = exitedFullscreen;
                form.submit();
            }

            function isQuestionAnswered(card) {
                return card.querySelector('input[type="radio"]:checked') !== null;
            }

            function updateNavigator() {
                var answeredCount = 0;
                questionCards.forEach(function(card, index) {
                    var answered = isQuestionAnswered(card);
                    if (answered) answeredCount++;
                    var navButton = navigatorButtons.querySelector('[data-question-index="' + index + '"]');
                    var isFlagged = flaggedQuestions.has(index);
                    if (!navButton) return;

                    navButton.classList.toggle('is-answered', answered);
                    navButton.classList.toggle('is-unanswered', !answered);
                    navButton.classList.toggle('is-flagged', isFlagged);
                    navButton.classList.toggle('is-current', currentQuestionIndex === index);
                    card.classList.toggle('is-current', currentQuestionIndex === index);
                    navButton.setAttribute('aria-current', currentQuestionIndex === index ? 'true' : 'false');
                    navButton.setAttribute('aria-label', 'Savol ' + (index + 1) + ': ' + (answered ? 'javoblangan' : 'javobsiz') + (isFlagged ? ', belgilangan' : ''));
                });
                navigatorSummary.textContent = answeredCount + ' ta javoblangan, ' + (questionCards.length - answeredCount) + ' ta javobsiz';
            }

            function showQuestion(index) {
                if (index < 0 || index >= questionCards.length) return;
                currentQuestionIndex = index;
                questionCards[index].scrollIntoView({ behavior: 'smooth', block: 'center' });
                questionCards[index].focus({ preventScroll: true });
                updateNavigator();
            }

            questionCards.forEach(function(card, index) {
                var navButton = document.createElement('button');
                navButton.type = 'button';
                navButton.className = 'btn question-nav-button is-unanswered';
                navButton.dataset.questionIndex = index;
                navButton.textContent = index + 1;
                navButton.addEventListener('click', function() {
                    showQuestion(index);
                });
                navigatorButtons.appendChild(navButton);

                card.querySelectorAll('input[type="radio"]').forEach(function(radio) {
                    radio.addEventListener('change', updateNavigator);
                });

                var flagButton = card.querySelector('.question-flag');
                flagButton.addEventListener('click', function() {
                    if (flaggedQuestions.has(index)) {
                        flaggedQuestions.delete(index);
                    } else {
                        flaggedQuestions.add(index);
                    }
                    flagButton.setAttribute('aria-pressed', flaggedQuestions.has(index) ? 'true' : 'false');
                    flagButton.textContent = flaggedQuestions.has(index) ? 'Belgilangan' : 'Belgila';
                    updateNavigator();
                });
            });

            updateNavigator();

            function showViolation(message) {
                banner.style.display = 'block';
                bannerText.textContent = message;
            }

            function registerViolation(reason) {
                if (submitted) return;
                tabSwitchCount++;
                showViolation(
                    'Ogohlantirish (' + tabSwitchCount + '/' + MAX_VIOLATIONS + '): ' + reason +
                    '. Bu holat o\'qituvchingizga ko\'rinadi.'
                );
                if (tabSwitchCount >= MAX_VIOLATIONS) {
                    showViolation('Ruxsat etilgan chegaradan oshdingiz. Imtihon avtomatik yakunlanmoqda.');
                    setTimeout(doSubmit, 1500);
                }
            }

            // Bir xil voqea (masalan fullscreen'dan chiqish) bir necha hodisani (fullscreenchange,
            // visibilitychange, blur) bir vaqtda qo'zg'atishi mumkin — shuning uchun qisqa vaqt oralig'ida
            // (500ms) kelgan qo'shimcha signallar bitta buzilish sifatida hisoblanadi, ular ikki-uch marta
            // hisoblanib ketmaydi. Lekin HAR BIR signal turi (fullscreen, visibility, blur) alohida-alohida
            // ishlaydi — biri "sukut" bo'lib qolsa ham (masalan ba'zi brauzerlarda Alt+Tab paytida fullscreen
            // saqlanib qolishi mumkin), boshqasi baribir ushlab qoladi.
            var lastViolationTime = 0;
            function registerViolationDebounced(reason) {
                var now = Date.now();
                if (now - lastViolationTime < 500) return;
                lastViolationTime = now;
                registerViolation(reason);
            }

            // --- Fullscreen ---
            function requestFullscreen() {
                var el = document.documentElement;
                var req = el.requestFullscreen || el.webkitRequestFullscreen || el.msRequestFullscreen;
                if (req) req.call(el);
            }

            function isFullscreen() {
                return !!(document.fullscreenElement || document.webkitFullscreenElement || document.msFullscreenElement);
            }

            document.addEventListener('fullscreenchange', onFullscreenChange);
            document.addEventListener('webkitfullscreenchange', onFullscreenChange);
            document.addEventListener('msfullscreenchange', onFullscreenChange);

            function onFullscreenChange() {
                if (!isFullscreen() && content.style.display !== 'none' && !submitted) {
                    exitedFullscreen = true;
                    registerViolationDebounced("Siz to'liq ekran rejimidan chiqdingiz");
                }
            }

            // --- Sahifadan (tab/oyna) chiqib ketish ---
            document.addEventListener('visibilitychange', function() {
                if (document.hidden && content.style.display !== 'none' && !submitted) {
                    registerViolationDebounced('Siz boshqa sahifaga/oynaga o\'tdingiz');
                }
            });

            // --- Fokusdan chiqish (Alt+Tab bilan boshqa dastur/oynaga o'tish) ---
            // Muhim: ba'zi brauzer/OS kombinatsiyalarida Alt+Tab bosilganda sahifa hali ham
            // "fullscreen" va "visible" (document.hidden === false) bo'lib qolishi mumkin, lekin
            // oyna fokusni yo'qotadi. Shu sababli bu holatni ham alohida ushlaymiz — aks holda
            // talaba fullscreen'dan chiqmasdan boshqa oynani ochib "yordam" izlashi mumkin edi.
            window.addEventListener('blur', function() {
                if (content.style.display !== 'none' && !submitted) {
                    registerViolationDebounced("Sahifa fokusdan chiqdi (boshqa oyna yoki dastur ochilgan bo'lishi mumkin)");
                }
            });

            // --- O'ng tugma va nusxalashni cheklash (qo'shimcha to'siq) ---
            document.addEventListener('contextmenu', function(e) {
                if (content.style.display !== 'none') e.preventDefault();
            });
            document.addEventListener('copy', function(e) {
                if (content.style.display !== 'none') e.preventDefault();
            });

            // --- Explicit final submit and implicit-submit protection ---
            submitBtn.addEventListener('click', function() {
                if (submitted) return;
                explicitSubmitRequested = true;
                doSubmit();
            });

            form.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    e.stopPropagation();
                }
            });

            form.addEventListener('submit', function(e) {
                if (!explicitSubmitRequested) {
                    e.preventDefault();
                    return;
                }
                submitted = true;
                clearInterval(interval);
            });

            // --- Imtihonni boshlash ---
            startBtn.addEventListener('click', function() {
                requestFullscreen();
                overlay.style.display = 'none';
                content.style.display = 'block';

                render();
                interval = setInterval(function() {
                    totalSeconds--;
                    render();
                    if (totalSeconds <= 0) {
                        doSubmit();
                    }
                }, 1000);
            });

        })();
    </script>
}
