@model IEnumerable<EduTrack.Models.Exam>

@{
    ViewData["Title"] = "Imtihonlar";
    var pendingRetakeExamIds = ViewBag.PendingRetakeExamIds as HashSet<int> ?? new HashSet<int>();
}

<h1>Imtihonlar</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="iz-empty"><i class="bi bi-clipboard-data"></i><p>Hozircha imtihon yo'q.</p></div>
}
else
{
    <div class="table-responsive">
    <table class="table table-bordered align-middle">
        <thead>
            <tr>
                <th>Nomi</th>
                <th>Fan</th>
                <th>Savollar soni</th>
                <th>Vaqt (daqiqa)</th>
                <th>Holat</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var myResult = item.Results
                    .OrderByDescending(r => r.AttemptNumber)
                    .ThenByDescending(r => r.CompletedDate)
                    .FirstOrDefault();
                var retakeAvailable = pendingRetakeExamIds.Contains(item.Id);
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Subject?.Name</td>
                    <td>@item.QuestionCount</td>
                    <td>@item.DurationMinutes</td>
                    <td>
                        @if (retakeAvailable)
                        {
                            <span class="badge bg-warning text-dark">Qayta topshirish ruxsati berildi</span>
                            <a asp-action="Take" asp-route-id="@item.Id" class="btn btn-sm btn-primary ms-2">Qayta topshirish</a>
                        }
                        else if (myResult != null)
                        {
                            <span class="badge bg-success">Topshirilgan: @myResult.CorrectAnswers / @myResult.TotalQuestions</span>
                            <a asp-action="Result" asp-route-id="@myResult.Id" class="btn btn-sm btn-outline-secondary ms-2">Natijani ko'rish</a>
                        }
                        else if (item.IsCurrentlyOpen)
                        {
                            <a asp-action="Take" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Boshlash</a>
                        }
                        else if (item.OpenAt.HasValue && AppClock.UzbekistanNow < item.OpenAt.Value)
                        {
                            <span class="badge bg-warning text-dark">
                                Hali ochilmagan (@item.OpenAt.Value.ToString("dd.MM.yyyy HH:mm") Toshkent vaqti bilan ochiladi)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Hozircha yopiq</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
