@model EduTrack.Models.Exam

@{
    ViewData["Title"] = "Imtihon natijalari";
    var pendingRetakeStudentIds = ViewBag.PendingRetakeStudentIds as HashSet<string> ?? new HashSet<string>();
}

<h1>@Model.Title — natijalar</h1>
<p class="text-muted">@Model.Subject?.Name | @Model.QuestionCount ta savol | @Model.DurationMinutes daqiqa</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.Results.Any())
{
    <div class="iz-empty"><i class="bi bi-bar-chart"></i><p>Hozircha hech kim bu imtihonni topshirmagan.</p></div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead>
                <tr>
                    <th>Talaba</th>
                    <th>To'g'ri javoblar</th>
                    <th>Foiz</th>
                    <th>Topshirgan vaqti</th>
                    <th>Ishonchlilik</th>
                    <th>Urinish</th>
                    <th>Holat</th>
                    <th>Amallar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var result in Model.Results.OrderByDescending(r => r.CompletedDate))
                {
                    var percent = result.TotalQuestions > 0
                        ? Math.Round(100.0 * result.CorrectAnswers / result.TotalQuestions, 1)
                        : 0;
                    var latestForStudent = Model.Results
                        .Where(r => r.StudentId == result.StudentId)
                        .OrderByDescending(r => r.AttemptNumber)
                        .ThenByDescending(r => r.CompletedDate)
                        .FirstOrDefault()?.Id == result.Id;
                    var pendingRetake = result.StudentId != null && pendingRetakeStudentIds.Contains(result.StudentId);
                    <tr class="@(latestForStudent ? "table-active" : "")">
                        <td>@result.Student?.FullName</td>
                        <td>@result.CorrectAnswers / @result.TotalQuestions</td>
                        <td>@percent %</td>
                        <td>@AppClock.ToUzbekistanTime(result.CompletedDate).ToString("dd.MM.yyyy HH:mm")</td>
                        <td><span class="badge bg-light text-dark">#@result.AttemptNumber</span></td>
                        <td>
                            @if (result.TabSwitchCount == 0 && !result.ExitedFullscreen)
                            {
                                <span class="badge" style="background-color: var(--iz-success-bg); color: var(--iz-success-text);">
                                    <i class="bi bi-shield-check"></i> Toza
                                </span>
                            }
                            else
                            {
                                <span class="badge" style="background-color: var(--iz-danger-bg); color: var(--iz-danger-text);"
                                      title="Sahifadan chiqib ketish: @result.TabSwitchCount marta">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    Shubhali (@result.TabSwitchCount marta)
                                </span>
                            }
                        </td>
                        <td>
                            @if (result.IsApproved)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Tasdiqlangan</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> Tasdiq kutilmoqda</span>
                            }
                        </td>
                        <td>
                            @if (!result.IsApproved)
                            {
                                <form asp-action="ApproveResult" method="post" class="d-inline">
                                    <input type="hidden" name="resultId" value="@result.Id" />
                                    <input type="hidden" name="examId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="bi bi-check-lg"></i> Tasdiqlash
                                    </button>
                                </form>
                            }
                            @if (latestForStudent && pendingRetake)
                            {
                                <span class="badge bg-warning text-dark">Qayta topshirish ochiq</span>
                            }
                            else if (latestForStudent)
                            {
                                <form asp-action="GrantRetake" method="post" class="d-inline"
                                      onsubmit="return confirm('Ushbu talabaga qayta topshirish ochilsinmi? Eski natija tarixda saqlanadi.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="resultId" value="@result.Id" />
                                    <input type="hidden" name="examId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-arrow-repeat"></i> Qayta topshirish
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-action="Index" class="btn btn-secondary">Orqaga</a>
