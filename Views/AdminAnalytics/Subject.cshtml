@model List<EduTrack.ViewModels.GroupAnalyticsSummaryViewModel>
@{
    ViewData["Title"] = "Analitika — " + ViewBag.SubjectName;
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
    <h1 class="mb-0">@ViewBag.SubjectName — Guruhlar</h1>
</div>

@if (!Model.Any())
{
    <div class="iz-empty"><i class="bi bi-people"></i><p>Bu fanga biriktirilgan guruh yo'q.</p></div>
}
else
{
    <div class="card shadow-sm border-0 rounded-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Guruh</th>
                        <th class="text-center">Talabalar</th>
                        <th class="text-center">Imtihon o'rtachasi</th>
                        <th class="text-center">Baholash o'rtachasi</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@g.GroupName</td>
                            <td class="text-center">@g.StudentCount</td>
                            <td class="text-center">
                                @if (g.AverageExamPercentage.HasValue)
                                {
                                    <span class="badge bg-primary">@g.AverageExamPercentage %</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (g.AverageGradePercentage.HasValue)
                                {
                                    <span class="badge bg-success">@g.AverageGradePercentage %</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Detail" asp-route-subjectId="@ViewBag.SubjectId" asp-route-groupId="@g.GroupId" class="btn btn-sm btn-outline-primary">
                                    Batafsil <i class="bi bi-arrow-right"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}