@*
    Matematik belgilar paneli. Tugmalar bosilganda eng yaqin matn maydoniga
    LaTeX bo'lagi qo'shiladi (wwwroot/js/assignments.js).
*@
<div class="iz-math-palette" role="toolbar" aria-label="Matematik belgilar">
    <button type="button" class="iz-math-key" data-insert="$...$" title="Formula chegarasi">$…$</button>
    <button type="button" class="iz-math-key" data-insert="\frac{}{}" title="Kasr">&frac12;</button>
    <button type="button" class="iz-math-key" data-insert="\sqrt{}" title="Kvadrat ildiz">&radic;</button>
    <button type="button" class="iz-math-key" data-insert="^{2}" title="Kvadrat">&sup2;</button>
    <button type="button" class="iz-math-key" data-insert="^{3}" title="Kub">&sup3;</button>
    <button type="button" class="iz-math-key" data-insert="\pi" title="Pi">&pi;</button>
    <button type="button" class="iz-math-key" data-insert="\alpha" title="Alfa">&alpha;</button>
    <button type="button" class="iz-math-key" data-insert="\beta" title="Beta">&beta;</button>
    <button type="button" class="iz-math-key" data-insert="\theta" title="Teta">&theta;</button>
    <button type="button" class="iz-math-key" data-insert="\le" title="Kichik yoki teng">&le;</button>
    <button type="button" class="iz-math-key" data-insert="\ge" title="Katta yoki teng">&ge;</button>
    <button type="button" class="iz-math-key" data-insert="\ne" title="Teng emas">&ne;</button>
    <button type="button" class="iz-math-key" data-insert="\pm" title="Plyus-minus">&plusmn;</button>
    <button type="button" class="iz-math-key" data-insert="\times" title="Ko'paytirish">&times;</button>
    <button type="button" class="iz-math-key" data-insert="\div" title="Bo'lish">&divide;</button>
    <button type="button" class="iz-math-key" data-insert="\approx" title="Taxminan">&asymp;</button>
    <button type="button" class="iz-math-key" data-insert="\infty" title="Cheksizlik">&infin;</button>
    <button type="button" class="iz-math-key" data-insert="\sum" title="Yig'indi">&sum;</button>
    <button type="button" class="iz-math-key" data-insert="\int" title="Integral">&int;</button>
    <button type="button" class="iz-math-key" data-insert="^\circ" title="Gradus">&deg;</button>
</div>
