@model EduTrack.ViewModels.SubjectFormViewModel

@{
    ViewData["Title"] = "Fanni tahrirlash";
}

<h1>Fanni tahrirlash</h1>

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="form-group mb-3">
        <label asp-for="Name" class="control-label">Fan nomi</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label class="control-label">O'qituvchi</label>
        <select asp-for="TeacherId" class="form-control" asp-items="@(new SelectList(ViewBag.Teachers, "Value", "Text"))">
            <option value="">-- Tanlanmagan --</option>
        </select>
    </div>
    <div class="form-group mb-3">
        <label class="control-label">Guruhlar</label>
        <div class="border rounded p-2">
            @foreach (var group in (List<EduTrack.Models.Group>)ViewBag.Groups)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                           name="SelectedGroupIds" value="@group.Id"
                           id="group_@group.Id"
                           checked="@(Model.SelectedGroupIds.Contains(group.Id))" />
                    <label class="form-check-label" for="group_@group.Id">@group.Name</label>
                </div>
            }
            @if (!((List<EduTrack.Models.Group>)ViewBag.Groups).Any())
            {
                <p class="text-muted mb-0">Hozircha guruhlar mavjud emas.</p>
            }
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Saqlash</button>
    <a asp-action="Index" class="btn btn-secondary">Bekor qilish</a>
</form>