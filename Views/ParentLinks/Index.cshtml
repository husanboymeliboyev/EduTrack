@model EduTrack.ViewModels.ParentLinkIndexViewModel
@{
    ViewData["Title"] = "Ota-ona bog‘lanishlari";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="text-uppercase small text-muted fw-semibold">Boshqaruv</span>
            <h1 class="h3 mb-1">Ota-ona bog‘lanishlari</h1>
            <p class="text-muted mb-0">Ota-onalarni farzandlari bilan xavfsiz bog‘lang.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Yangi bog‘lanish</a>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }

    @if (Model.Links.Count == 0)
    {
        <div class="card border-0 shadow-sm p-4">
            <h2 class="h5">Hozircha bog‘lanishlar mavjud emas</h2>
            <p class="text-muted mb-0">Parent akkauntini farzand bilan bog‘lash uchun yangi bog‘lanish yarating.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Ota-ona</th>
                            <th>Farzand</th>
                            <th>Guruh</th>
                            <th>Holat</th>
                            <th class="text-end">Amal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var link in Model.Links)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@link.ParentName</div>
                                    <small class="text-muted">Login: @link.ParentLoginId</small>
                                </td>
                                <td>@link.StudentName</td>
                                <td>@(string.IsNullOrWhiteSpace(link.GroupName) ? "—" : link.GroupName)</td>
                                <td>
                                    @if (link.IsActive)
                                    {
                                        <span class="badge text-bg-success">Faol</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Bekor qilingan</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (link.IsActive)
                                    {
                                        <form asp-action="Revoke" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@link.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Bekor qilish</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Tarix saqlangan</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
