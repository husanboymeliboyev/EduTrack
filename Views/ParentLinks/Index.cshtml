@model List<EduTrack.ViewModels.ParentLinkListItemViewModel>
@{
    ViewData["Title"] = "Ota-ona va talaba bog'lanishlari";
}

<h1>Ota-ona va talaba bog'lanishlari</h1>
<div class="iz-signature-line"></div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="alert alert-info">
    <strong>Ota-onalar uchun kirish havolasi:</strong>
    <code>@Url.Action("Login", "ParentPortal", null, Context.Request.Scheme)</code><br />
    <small>
        Ota-ona hisobini "Foydalanuvchilar" bo'limida "Parent" roli bilan yarating, so'ng shu yerda farzandiga
        bog'lang. Login ID va vaqtinchalik parolni ota-onaga bering — ular shu havola orqali kiradi.
    </small>
</div>

<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body">
        <h5 class="mb-3"><i class="bi bi-link-45deg"></i> Yangi bog'lanish qo'shish</h5>
        <form asp-action="Link" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-5">
                <label class="form-label">Ota-ona</label>
                <select name="parentId" class="form-control" asp-items="ViewBag.Parents">
                    <option value="">-- Tanlang --</option>
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label">Talaba</label>
                <select name="studentId" class="form-control" asp-items="ViewBag.Students">
                    <option value="">-- Tanlang --</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-plus-lg"></i> Bog'lash
                </button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="iz-empty">
        <i class="bi bi-people"></i>
        <p>Hozircha bog'lanishlar yo'q.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Ota-ona</th>
                    <th>Login ID</th>
                    <th>Talaba</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ParentName</td>
                        <td><code>@item.ParentLoginId</code></td>
                        <td>@item.StudentName</td>
                        <td class="text-end">
                            <form asp-action="Unlink" method="post" class="d-inline"
                                  onsubmit="return confirm('Bu bog\'lanishni o\'chirishni xohlaysizmi?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-x-lg"></i> O'chirish
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}